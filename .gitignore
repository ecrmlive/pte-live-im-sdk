.DS_Store
build/
**/node_modules/
**/dist/
**/.gradle/
**/.kotlin/
**/.build/
**/BuildProfile.ets
*.log
*.lock

# Local and production runtime configuration. Commit only explicitly named
# non-secret examples such as config/sdk.example.yaml.
/.env
/.env.*
**/.env
**/.env.*
!/\.env.example
!**/.env.example
/config/local/*.yaml
/config/local/*.yml
/config/prod/*.yaml
/config/prod/*.yml
**/*.local.yaml
**/*.local.yml
**/*.secret.yaml
**/*.secret.yml
**/*.secrets.yaml
**/*.secrets.yml
**/app.yaml
**/app.yml

# Private keys, certificates, mobile signing material, and deployment secrets.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
*.xcarchive
**/google-services.json
**/GoogleService-Info.plist
**/Secrets.xcconfig
**/Config.local.xcconfig
/deploy/secrets/
/release/**/config/local/
/release/**/config/prod/
