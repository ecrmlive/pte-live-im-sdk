<template>
  <view v-if="screen === 'login'" :class="['page', { dark: darkMode }]">
    <PteIMUINavigationBar :language="selectedLanguage" :dark="darkMode" @language-select="selectLanguage" @theme-select="selectTheme" />
    <view class="brand"><image class="brand-logo" src="/static/pte-im-ui-logo.png" mode="aspectFit" /><text class="brand-title">PrivateChat</text><text class="brand-subtitle">Secure · Private · Efficient</text></view>
    <view class="login-card">
      <text class="form-label">SDKAppID</text><input v-model="sdkAppId" class="input" type="number" placeholder="SDKAppID" />
      <text class="form-label">User ID</text><input v-model="userId" class="input" type="number" placeholder="User ID" />
      <text class="form-label">User Signature (UserSig)</text><textarea v-model="userSig" class="signature" placeholder="Paste your UserSig token" password="true" /><view class="action-spacer"></view>
      <button class="login-button" @click="businessLogin">{{ english ? 'Login' : '登录' }}</button><text v-if="status.length > 0" class="error">{{ status }}</text>
    </view>
  </view>

  <view v-else :class="['shell', { dark: darkMode }]">
    <view v-if="screen === 'conversations'" class="screen"><PteIMUIConversationList :client="client" @select="openChat" /></view>
    <view v-else-if="screen === 'contacts'" class="screen contacts"><PteIMUIContactList :client="client" mode="friends" @add="businessNotice('添加好友')" @add-group="openDemoGroup" @select="openContactChat" @error="contactError" /></view>
    <view v-else-if="screen === 'profile'" class="screen profile"><view class="profile-nav"><view class="profile-nav-brand"><image src="/uni_modules/pte-im-uikit/static/shell/logo.png" mode="aspectFit" /><text>{{ english ? 'Me' : '我的' }}</text></view><view class="profile-nav-actions"><button @click="toggleAppearance"><image :src="darkMode ? '/uni_modules/pte-im-uikit/static/shell/theme-dark.png' : '/uni_modules/pte-im-uikit/static/shell/theme-light.png'" mode="aspectFit" /></button><button @click="toggleLanguage"><image :src="darkMode ? '/uni_modules/pte-im-uikit/static/shell/language-dark.png' : '/uni_modules/pte-im-uikit/static/shell/language-light.png'" mode="aspectFit" /></button></view></view><view class="profile-banner"><view class="profile-avatar"><text>{{ english ? 'Me' : '我' }}</text></view><view class="profile-copy"><text class="profile-name">User_{{ userId }}</text><text class="profile-id">ID: usr_{{ userId }}</text></view><image class="profile-arrow" src="/uni_modules/pte-im-uikit/static/shell/arrow.png" mode="aspectFit" /></view><view class="shortcuts"><view class="shortcut"><image src="/uni_modules/pte-im-uikit/static/shell/profile-favorites.png" mode="aspectFit" /><text class="shortcut-value">12</text><text>{{ english ? 'Favorites' : '我的收藏' }}</text></view><view class="shortcut"><image src="/uni_modules/pte-im-uikit/static/shell/profile-wallet.png" mode="aspectFit" /><text class="shortcut-value">¥88</text><text>{{ english ? 'Wallet' : '我的钱包' }}</text></view><view class="shortcut"><image src="/uni_modules/pte-im-uikit/static/shell/profile-qr.png" mode="aspectFit" /><text class="shortcut-value">QR Card</text><text>{{ english ? 'QR Card' : '二维码名片' }}</text></view></view><view class="settings"><view class="setting"><view><image src="/uni_modules/pte-im-uikit/static/shell/profile-theme.png" mode="aspectFit" /><text>{{ english ? (darkMode ? 'Dark Mode' : 'Light Mode') : (darkMode ? '深色模式' : '浅色模式') }}</text></view><image class="setting-switch" :src="darkMode ? '/uni_modules/pte-im-uikit/static/shell/switch-on.png' : '/uni_modules/pte-im-uikit/static/shell/switch-off.png'" mode="aspectFit" @click="toggleAppearance" /></view><view class="setting" @click="toggleLanguage"><view><image src="/uni_modules/pte-im-uikit/static/shell/profile-language.png" mode="aspectFit" /><text>{{ english ? 'Language' : '语言' }}</text></view><text class="language-badge">{{ english ? 'EN' : '中文' }}</text></view><view v-for="item in profileSettings()" :key="item.title" class="setting" @click="businessNotice(item.title)"><view><image :src="item.icon" mode="aspectFit" /><text>{{ item.title }}</text></view><image class="profile-arrow" src="/uni_modules/pte-im-uikit/static/shell/arrow.png" mode="aspectFit" /></view></view><button class="logout" @click="logout"><image src="/uni_modules/pte-im-uikit/static/shell/profile-logout.png" mode="aspectFit" /><text>{{ english ? 'Log Out' : '退出登录' }}</text></button></view>
    <view v-else class="screen chat"><PteIMUIChat :client="client" :conversation-id="conversationId" title="PteIMUIDemo" :media-resolver="resolveMedia" @back="screen = 'conversations'" @action="handleAction" @message-action="handleMessageAction" @error="showNotice" /></view>
    <view class="tabbar"><button :class="['tab', { selected: screen === 'conversations' }]" @click="screen = 'conversations'">{{ english ? 'Chats' : '会话' }}</button><button :class="['tab', { selected: screen === 'contacts' }]" @click="screen = 'contacts'">{{ english ? 'Contacts' : '联系人' }}</button><button :class="['tab', { selected: screen === 'profile' }]" @click="screen = 'profile'">{{ english ? 'Me' : '我的' }}</button></view>
  </view>
</template>

<script lang="uts">
import PteIMUIChat from '../../../../uni_modules/pte-im-uikit/components/PteIMUIChat/PteIMUIChat.uvue'
import PteIMUIConversationList from '../../../../uni_modules/pte-im-uikit/components/PteIMUIConversationList/PteIMUIConversationList.uvue'
import PteIMUIContactList from '../../../../uni_modules/pte-im-uikit/components/PteIMUIContactList/PteIMUIContactList.uvue'
import PteIMUINavigationBar from '../../../../uni_modules/pte-im-uikit/components/PteIMUINavigationBar/PteIMUINavigationBar.uvue'
import { PteIMBusinessContent, PteIMLocation } from '../../../../uni_modules/pte-im-sdk/utssdk/interface.uts'
import { PteIMUIAction } from '../../../../uni_modules/pte-im-uikit/utssdk/PteIMUIKitFacade.uts'
import { PteIMUIDemoBaseConfig } from '../../PteIMUIDemoConfig.uts'
// #ifdef WEB
import { createPteIMSDK } from '../../../../uni_modules/pte-im-sdk/utssdk/web/index.uts'
// #endif
// #ifdef MP-WEIXIN
import { createPteIMSDK } from '../../../../uni_modules/pte-im-sdk/utssdk/mp-weixin/index.uts'
// #endif

export default {
  components: { PteIMUIChat, PteIMUIConversationList, PteIMUIContactList, PteIMUINavigationBar },
  data() { return { sdkAppId: '432532532', userId: '123654', userSig: '', conversationId: '', status: '', screen: 'login', client: null as any, darkMode: false, english: true, selectedLanguage: 'en-US' } },
  methods: {
    businessLogin() {
      try {
        if (this.userId.length === 0 || this.userSig.length === 0) throw new Error('业务后端应返回 userId 与短期 UserSig')
        const client = createPteIMSDK(PteIMUIDemoBaseConfig).login({ sdkAppId: Number(this.sdkAppId), userId: this.userId, userSig: this.userSig })
        client.onError((message: string) => this.status = `错误：${message}`); client.start(); this.client = client; this.screen = 'conversations'
      } catch (error) { this.status = `登录错误：${error instanceof Error ? error.message : String(error)}` }
    },
    openChat(conversationId: string) { this.conversationId = conversationId; this.screen = 'chat' },
    openContactChat(payload: any) { this.openChat(String(payload.conversationId)) },
    contactError(message: string) { this.status = `联系人加载失败：${message}` },
    openDemoGroup() { if (this.client == null) return; this.client.createGroupConversation('PteIMUIDemo Group', [10002, 10003], null, (conversation: any, error: string | null) => { if (conversation == null || error != null) { this.status = `无法创建群组：${error ?? 'unknown error'}`; return }; this.openChat(String(conversation.id)) }) },
    logout() { if (this.client != null) this.client.stop(); this.client = null; this.screen = 'login'; this.userSig = ''; this.status = '' },
    selectLanguage(language: string) { this.selectedLanguage = language; this.english = language !== 'zh-CN'; if (this.client != null) this.client.updateAppearance(null, language) },
    selectTheme(theme: string) { this.darkMode = theme === 'dark'; if (this.client != null) this.client.updateAppearance(this.darkMode ? 'dark' : 'light', null) },
    toggleLanguage() { this.selectLanguage(this.english ? 'zh-CN' : 'en-US') },
    toggleAppearance() { this.selectTheme(this.darkMode ? 'light' : 'dark') },
    onThemeSwitch(event: any) { this.darkMode = !event.detail.value; if (this.client != null) this.client.updateAppearance(this.darkMode ? 'dark' : 'light', null) },
    profileSettings(): any[] { return [{ title: this.english ? 'Notifications' : '通知设置', icon: '/uni_modules/pte-im-uikit/static/shell/profile-notification.png' }, { title: this.english ? 'Privacy & Security' : '隐私与安全', icon: '/uni_modules/pte-im-uikit/static/shell/profile-privacy.png' }, { title: this.english ? 'Help & Feedback' : '帮助与反馈', icon: '/uni_modules/pte-im-uikit/static/shell/profile-help.png' }, { title: this.english ? 'Settings' : '设置', icon: '/uni_modules/pte-im-uikit/static/shell/profile-settings.png' }] },
    businessNotice(title: string) { this.status = `${title}由业务层实现` },
    resolveMedia(value: string): string { if (value.length === 0 || value.indexOf('http://') === 0 || value.indexOf('https://') === 0 || value.indexOf('wxfile://') === 0) return value; return PteIMUIDemoBaseConfig.cosDomain.replace(/\/$/, '') + '/' + value.replace(/^\//, '') },
    showNotice(message: string) { this.status = message; uni.showToast({ title: message, icon: 'none' }) },
    handleMessageAction(payload: any) { const action = String(payload.action ?? ''); if (action === 'delete' || action === 'revoke' || action === 'retry' || action === 'reaction') this.showNotice(`${action} 需要业务消息操作接口`); },
    handleAction(action: PteIMUIAction) { if (this.client == null) return; if (action === 'image' || action === 'camera' || action === 'video' || action === 'voice') { this.pickMedia(action === 'camera' ? 'image' : action); return }; if (action === 'file') { this.status = '请由宿主选择文件后调用 uploadAndSendFile。'; return }; if (action === 'location') this.client.sendLocation(this.conversationId, { latitude: 31.2304, longitude: 121.4737, name: 'Shanghai', address: 'PteIMUIDemo' } as PteIMLocation); else { const content = { businessId: `demo-${Date.now()}`, title: action } as PteIMBusinessContent; if (action === 'gift') this.client.sendGift(this.conversationId, content); else if (action === 'red_packet') this.client.sendRedPacket(this.conversationId, content); else this.client.sendOrder(this.conversationId, content) } },
    pickMedia(type: PteIMUIAction) {
      // #ifdef MP-WEIXIN
      uni.chooseMedia({ count: 1, mediaType: type === 'image' ? ['image'] : type === 'video' ? ['video'] : ['mix'], success: (result: any) => { const path = result.tempFiles[0].tempFilePath as string; if (type === 'image') this.client.uploadAndSendImage(this.conversationId, path); else if (type === 'video') this.client.uploadAndSendVideo(this.conversationId, path); else this.client.uploadAndSendVoice(this.conversationId, path, 1000) } })
      // #endif
      // #ifdef WEB
      this.status = 'H5 请由宿主选择文件后调用 uploadAndSend*。'
      // #endif
    },
  },
}
</script>

<style>
.page { min-height: 100%; padding: 10px 20px 28px; box-sizing: border-box; background-color: #F4F4FF; }.page.dark { background-color: #0E0F1F; }.brand { display: flex; flex-direction: column; align-items: center; margin: 24px 0 30px; }.brand-logo { width: 96px; height: 96px; }.brand-title { margin-top: 10px; color: #17182B; font-size: 29px; font-weight: 700; }.dark .brand-title { color: #FFFFFF; }.brand-subtitle { margin-top: 6px; color: #656982; font-size: 14px; }.login-card { padding: 24px; border-radius: 24px; background-color: #FFFFFF; box-shadow: 0 8px 18px rgba(34, 28, 76, .12); }.form-label { display: block; margin-bottom: 7px; color: #17182B; font-size: 13px; font-weight: 600; }.input, .signature { box-sizing: border-box; width: 100%; margin-bottom: 10px; padding: 0 16px; border: 0; border-radius: 18px; background-color: #EDE9FF; color: #17182B; font-size: 15px; }.input { height: 46px; }.signature { height: 82px; padding-top: 10px; }.action-spacer { height: 28px; }.login-button { width: 100%; height: 50px; margin-top: 4px; border: 0; border-radius: 18px; background-color: #6F41F0; color: #FFFFFF; font-size: 16px; font-weight: 700; }.error { display: block; margin-top: 10px; color: #BE3746; font-size: 12px; text-align: center; }.shell, .screen { height: 100%; }.shell { display: flex; flex-direction: column; background-color: #F4F4FF; }.shell.dark { background-color: #08091D; }.screen { flex: 1; overflow: hidden; }.contacts, .profile { overflow-y: auto; }.profile-nav { display: flex; min-height: 44px; align-items: center; justify-content: space-between; padding: 0 16px; border-bottom: 1px solid #E6E8F5; background-color: #FFFFFF; }.dark .profile-nav { border-color: #29234A; background-color: #10102A; }.profile-nav-brand { display: flex; align-items: center; color: #17182B; font-size: 18px; font-weight: 700; }.dark .profile-nav-brand { color: #FFFFFF; }.profile-nav-brand image { width: 28px; height: 28px; margin-right: 8px; }.profile-nav-actions { display: flex; gap: 6px; }.profile-nav-actions button { display: flex; width: 30px; height: 44px; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; }.profile-nav-actions image { width: 20px; height: 20px; }.profile-banner { display: flex; align-items: center; min-height: 112px; padding: 0 20px; background-color: #E6EAFF; }.dark .profile-banner { background-color: #101435; }.profile-avatar { display: flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 16px; background-color: #416AF4; color: #FFFFFF; font-size: 24px; font-weight: 700; }.profile-copy { display: flex; flex: 1; flex-direction: column; margin-left: 15px; }.profile-name { color: #17182B; font-size: 17px; font-weight: 700; }.profile-id { margin-top: 5px; color: #656982; font-size: 11px; }.dark .profile-name { color: #FFFFFF; }.dark .profile-id { color: #A7A9C8; }.profile-arrow { width: 16px; height: 16px; }.shortcuts { display: flex; min-height: 94px; border-bottom: 1px solid #E6E8F5; background-color: #FFFFFF; }.dark .shortcuts { border-color: #29234A; background-color: #10102A; }.shortcut { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid #E6E8F5; color: #656982; font-size: 10px; }.shortcut:last-child { border-right: 0; }.dark .shortcut { border-color: #29234A; color: #A7A9C8; }.shortcut image { width: 22px; height: 22px; }.shortcut-value { margin: 3px 0; color: #17182B; font-size: 13px; font-weight: 600; }.dark .shortcut-value { color: #FFFFFF; }.settings { padding: 10px 20px; }.setting { display: flex; align-items: center; justify-content: space-between; min-height: 54px; border-bottom: 1px solid #E6E8F5; color: #17182B; font-size: 14px; }.dark .setting { border-color: #29234A; color: #FFFFFF; }.setting view { display: flex; align-items: center; }.setting view image { width: 20px; height: 20px; margin-right: 12px; }.setting-switch { width: 48px; height: 28px; }.language-badge { padding: 5px 11px; border-radius: 14px; background-color: #EEE9FF; color: #6F41F0; font-size: 12px; }.dark .language-badge { background-color: #29234A; color: #A779FF; }.logout { display: flex; width: calc(100% - 40px); height: 48px; align-items: center; justify-content: center; gap: 8px; margin: 5px 20px 20px; border: 0; border-radius: 16px; background-color: #FFE9EB; color: #D23E4A; font-size: 14px; font-weight: 600; }.logout image { width: 18px; height: 18px; }.dark .logout { background-color: #291221; color: #FF5967; }.tabbar { display: flex; min-height: 56px; padding-bottom: env(safe-area-inset-bottom); border-top: 1px solid #E8E8F2; background-color: #FFFFFF; }.dark .tabbar { border-color: #29234A; background-color: #10102A; }.tab { flex: 1; margin: 0; border: 0; background-color: transparent; color: #656982; font-size: 12px; }.dark .tab { color: #A7A9C8; }.tab.selected { color: #6F41F0; font-weight: 700; }
</style>
