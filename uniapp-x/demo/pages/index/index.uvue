<template>
  <view v-if="client == null" class="page">
    <view class="card">
      <text class="title">PteIMUIKit · uni-app x</text>
      <text class="hint">Demo 仅完成运行时登录，聊天界面直接使用 PteIMUIChat。</text>
      <input v-model="apiDomain" class="input" placeholder="API domain" /><input v-model="imDomain" class="input" placeholder="IM WSS URL" /><input v-model="cosDomain" class="input" placeholder="COS domain" />
      <input v-model="sdkAppId" class="input" type="number" placeholder="SDK App ID" /><input v-model="userId" class="input" type="number" placeholder="Numeric user ID" /><input v-model="userSig" class="input" password="true" placeholder="由业务后端签发的 UserSig" />
      <input v-model="conversationId" class="input" placeholder="Conversation ID" /><button @click="connect">连接并打开 PteIMUIKit</button><text class="status">{{ status }}</text>
    </view>
  </view>
  <view v-else class="chat-page">
    <PteIMUIChat :client="client" :conversation-id="conversationId" title="PteIMUIKit · uni-app x" @action="handleAction" />
  </view>
</template>

<script lang="uts">
import PteIMUIChat from '../../../../uni_modules/pte-live-im/components/PteIMUIChat/PteIMUIChat.uvue'
import { PteIMBusinessContent, PteIMLocation } from '../../../../uni_modules/pte-live-im/utssdk/interface.uts'
import { PteIMUIAction } from '../../../../uni_modules/pte-live-im/utssdk/PteIMUIKit.uts'
// #ifdef WEB
import { createPteLiveIM } from '../../../../uni_modules/pte-live-im/utssdk/web/index.uts'
// #endif
// #ifdef MP-WEIXIN
import { createPteLiveIM } from '../../../../uni_modules/pte-live-im/utssdk/mp-weixin/index.uts'
// #endif

export default {
  components: { PteIMUIChat },
  data() { return { apiDomain: 'https://api.example.com', imDomain: 'wss://im.example.com/ws', cosDomain: 'https://cos.example.com', sdkAppId: '1400000001', userId: '10001', userSig: '', conversationId: 'c2c:10001:10002', status: '未连接；Demo 不会保存 UserSig', client: null as any } },
  methods: {
    connect() {
      try { const client = createPteLiveIM({ apiDomain: this.apiDomain, imDomain: this.imDomain, cosDomain: this.cosDomain, themeMode: 'system', language: 'system' }).login({ sdkAppId: Number(this.sdkAppId), userId: this.userId, userSig: this.userSig }); client.onError((message: string) => this.status = `错误：${message}`); client.start(); this.client = client } catch (error) { this.status = `配置错误：${error instanceof Error ? error.message : String(error)}` }
    },
    handleAction(action: PteIMUIAction) {
      if (this.client == null) return
      if (action === 'image' || action === 'video' || action === 'voice') { this.pickMedia(action); return }
      if (action === 'location') this.client.sendLocation(this.conversationId, { latitude: 31.2304, longitude: 121.4737, name: 'Shanghai', address: 'PteIMUIKit demo' } as PteIMLocation)
      else { const content = { businessId: `demo-${Date.now()}`, title: action } as PteIMBusinessContent; if (action === 'gift') this.client.sendGift(this.conversationId, content); else if (action === 'red_packet') this.client.sendRedPacket(this.conversationId, content); else this.client.sendOrder(this.conversationId, content) }
    },
    pickMedia(type: PteIMUIAction) {
      // #ifdef MP-WEIXIN
      uni.chooseMedia({ count: 1, mediaType: type === 'image' ? ['image'] : type === 'video' ? ['video'] : ['mix'], success: (result: any) => { const path = result.tempFiles[0].tempFilePath as string; if (type === 'image') this.client.uploadAndSendImage(this.conversationId, path); else if (type === 'video') this.client.uploadAndSendVideo(this.conversationId, path); else this.client.uploadAndSendVoice(this.conversationId, path, 1000) } })
      // #endif
      // #ifdef WEB
      this.status = 'H5 请由宿主选择文件后调用 uploadAndSend*。'
      // #endif
    },
  },
}
</script>

<style>
.page, .chat-page { height: 100%; }.page { padding: 24rpx; box-sizing: border-box; background-color: #F7F9FC; }.card { padding: 24rpx; border-radius: 16rpx; background-color: #FFFFFF; }.title { display: block; margin-bottom: 12rpx; font-size: 40rpx; font-weight: 700; color: #1769AA; }.hint, .status { display: block; margin: 12rpx 0; font-size: 24rpx; color: #687385; }.input { height: 72rpx; margin-bottom: 12rpx; padding: 0 16rpx; border: 1px solid #D6DCE5; border-radius: 10rpx; }
</style>
