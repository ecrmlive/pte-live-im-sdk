{
  "app": {
    "signingConfigs": [],
    "products": [{
      "name": "default",
      "signingConfig": "default",
      "compileSdkVersion": 23,
      "compatibleSdkVersion": 23,
      "targetSdkVersion": 23,
      "runtimeOS": "OpenHarmony"
    }],
    "buildModeSet": [{ "name": "debug" }, { "name": "release" }]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    },
    {
      "name": "pte_im_sdk",
      "srcPath": "../PteIMSDK",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    },
    {
      "name": "pte_im_uikit",
      "srcPath": "../PteIMUIkit",
      "targets": [{ "name": "default", "applyToProducts": ["default"] }]
    }
  ]
}
