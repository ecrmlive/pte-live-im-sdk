import { PteIMConversation, PteIMIncomingMessage, PteIMSDKClient } from './interface.uts'

/** Actions that require host application permissions, pickers, or business data. */
export type PteIMUIAction = 'image' | 'video' | 'voice' | 'location' | 'gift' | 'red_packet' | 'order'

/** Explicit colours for one appearance. Light and dark palettes are never auto-inverted. */
export type PteIMUIThemePalette = {
  background: string; surface: string; composer: string; incoming: string; outgoingStart: string; outgoingEnd: string
  text: string; muted: string; incomingText: string; outgoingText: string; icon: string; divider: string; panel: string; panelItem: string
}

/** Pass a custom instance to PteIMUIChat when the host needs per-component branding. */
export class PteIMUITheme {
  light: PteIMUIThemePalette
  dark: PteIMUIThemePalette
  constructor(light: PteIMUIThemePalette = PteIMUITheme.lightPalette(), dark: PteIMUIThemePalette = PteIMUITheme.darkPalette()) { this.light = light; this.dark = dark }
  static lightPalette(): PteIMUIThemePalette { return { background: '#F7F9FF', surface: '#FFFFFF', composer: '#FFFFFF', incoming: '#EDF1FD', outgoingStart: '#335EF4', outgoingEnd: '#7D40EF', text: '#171C2E', muted: '#666D84', incomingText: '#171C2E', outgoingText: '#FFFFFF', icon: '#373E5A', divider: '#DDE2F2', panel: '#F4F6FF', panelItem: '#FFFFFF' } }
  static darkPalette(): PteIMUIThemePalette { return { background: '#0E111C', surface: '#141827', composer: '#181D2F', incoming: '#252B43', outgoingStart: '#4467FF', outgoingEnd: '#8F4CFF', text: '#EFF2FF', muted: '#A4ADCB', incomingText: '#EFF2FF', outgoingText: '#FFFFFF', icon: '#CCD3F2', divider: '#313854', panel: '#191E30', panelItem: '#262D46' } }
}

/** Dependency-free controller consumed by the PteIMUI uvue components or a custom UTS view. */
export class PteIMUIChatController {
  messages: PteIMIncomingMessage[] = []
  onChanged: (() => void) | null = null
  onActionRequested: ((action: PteIMUIAction) => void) | null = null
  private active: boolean = true

  constructor(private client: PteIMSDKClient, readonly conversationId: string) {
    this.refresh()
    client.onMessage((message: PteIMIncomingMessage) => { if (this.active && message.conversationId == conversationId) this.refresh() })
    client.onMessageStateChanged((_event) => { if (this.active) this.refresh() })
    client.onThemeModeChanged((_mode) => { if (this.active) this.changed() })
    client.onLanguageChanged((_language) => { if (this.active) this.changed() })
  }

  refresh(): void { this.messages = this.client.localMessages(this.conversationId, 100); this.changed() }
  sendText(text: string): void { if (text.trim().length > 0) { this.client.sendText(this.conversationId, text.trim()); this.refresh() } }
  sendEmoji(packageId: string = 'default', emojiId: string = 'smile_001'): void { this.client.sendEmoji(this.conversationId, packageId, emojiId); this.refresh() }
  requestAction(action: PteIMUIAction): void { this.onActionRequested?.(action) }
  dispose(): void { this.active = false; this.onChanged = null; this.onActionRequested = null }
  private changed(): void { this.onChanged?.() }
}

/** Cache-first conversation controller. Call refresh after an explicit sync when necessary. */
export class PteIMUIConversationListController {
  conversations: PteIMConversation[] = []
  onChanged: (() => void) | null = null
  private active: boolean = true
  constructor(private client: PteIMSDKClient) {
    this.refresh()
    client.onMessage((_message) => { if (this.active) this.refresh() })
    client.onMessageStateChanged((_event) => { if (this.active) this.refresh() })
  }
  refresh(): void { this.conversations = this.client.localConversations(100); this.onChanged?.() }
  dispose(): void { this.active = false; this.onChanged = null }
}

/** Public UTS UI Kit entry point, independent from configuration and login. */
export class PteIMUIkit {
  static createChatController(client: PteIMSDKClient, conversationId: string): PteIMUIChatController { return new PteIMUIChatController(client, conversationId) }
  static createConversationListController(client: PteIMSDKClient): PteIMUIConversationListController { return new PteIMUIConversationListController(client) }
}
