<template>
  <view class="pte-im-ui-list" :style="themeStyle">
    <view class="pte-im-ui-list-nav"><view class="pte-im-ui-brand"><image class="pte-im-ui-brand-logo" src="/uni_modules/pte-im-uikit/static/shell/logo.png" mode="aspectFit" /><text class="pte-im-ui-list-title">{{ language === 'en-US' ? 'Chats' : '会话' }}</text></view><view class="pte-im-ui-nav-actions"><button @click="toggleAppearance"><image :src="isDark ? '/uni_modules/pte-im-uikit/static/shell/theme-dark.png' : '/uni_modules/pte-im-uikit/static/shell/theme-light.png'" mode="aspectFit" /></button><button @click="toggleLanguage"><image :src="isDark ? '/uni_modules/pte-im-uikit/static/shell/language-dark.png' : '/uni_modules/pte-im-uikit/static/shell/language-light.png'" mode="aspectFit" /></button><button @click="$emit('add')"><image :src="isDark ? '/uni_modules/pte-im-uikit/static/shell/add-dark.png' : '/uni_modules/pte-im-uikit/static/shell/add-light.png'" mode="aspectFit" /></button></view></view>
    <view class="pte-im-ui-search"><image src="/uni_modules/pte-im-uikit/static/shell/search.png" mode="aspectFit" /><input v-model="query" :placeholder="language === 'en-US' ? 'Search' : '搜索'" /></view>
    <scroll-view class="pte-im-ui-list-scroll" scroll-y="true"><view v-for="conversation in filteredConversations()" :key="conversation.conversationId" class="pte-im-ui-row" @click="$emit('select', conversation.conversationId)"><view class="pte-im-ui-avatar"><text>{{ avatar(conversation.conversationId) }}</text></view><view class="pte-im-ui-row-copy"><text class="pte-im-ui-name">{{ conversation.conversationId }}</text><text class="pte-im-ui-preview">{{ preview(conversation.lastMessage) }}</text></view><view class="pte-im-ui-row-meta"><text>{{ time(conversation.updatedAt) }}</text></view></view><view v-if="filteredConversations().length === 0" class="pte-im-ui-empty"><text>{{ language === 'en-US' ? 'No conversations yet' : '暂无会话' }}</text></view></scroll-view>
  </view>
</template>

<script lang="uts">
import { PteIMConversation, PteIMIncomingMessage, PteIMSDKClient } from '../../../pte-im-sdk/utssdk/interface.uts'
import { PteIMUIConversationListController, PteIMUIKit, PteIMUITheme } from '../../utssdk/PteIMUIKitFacade.uts'
export default {
  props: { client: { type: Object, required: true }, theme: { type: Object, default: null } }, emits: ['select', 'add'],
  data() { return { conversations: [] as PteIMConversation[], query: '', language: 'zh-CN', isDark: false, themeStyle: {} as any, controller: null as PteIMUIConversationListController | null } },
  mounted() { const controller = PteIMUIKit.createConversationListController(this.client as PteIMSDKClient); controller.onChanged = () => { this.conversations = controller.conversations; this.applyTheme() }; this.controller = controller; controller.refresh(); this.applyTheme() },
  beforeUnmount() { this.controller?.dispose() },
  methods: { preview(message: PteIMIncomingMessage): string { const value = message.content as any; const en = this.language === 'en-US'; if (message.type === 'text') return String(value.text ?? ''); if (message.type === 'image') return en ? '[Image]' : '[图片]'; if (message.type === 'voice') return en ? '[Voice]' : '[语音]'; if (message.type === 'red_packet') return en ? '[Red packet]' : '[红包]'; return '[' + message.type + ']' }, avatar(id: string): string { return id.length > 0 ? id.substring(0, 1).toUpperCase() : '?' }, time(value: number): string { const date = new Date(value); const today = new Date(); if (date.getFullYear() === today.getFullYear() && date.getMonth() === today.getMonth() && date.getDate() === today.getDate()) return String(date.getHours()).padStart(2, '0') + ':' + String(date.getMinutes()).padStart(2, '0'); return this.language === 'en-US' ? 'Yesterday' : '昨天' }, filteredConversations(): PteIMConversation[] { const query = this.query.trim().toLowerCase(); return query.length === 0 ? this.conversations : this.conversations.filter((item: PteIMConversation) => item.conversationId.toLowerCase().indexOf(query) >= 0 || this.preview(item.lastMessage).toLowerCase().indexOf(query) >= 0) }, toggleAppearance() { const client = this.client as PteIMSDKClient; const appearance = client.currentAppearance(); client.updateAppearance(appearance.themeMode === 'dark' ? 'light' : 'dark', appearance.language); this.applyTheme() }, toggleLanguage() { const client = this.client as PteIMSDKClient; const appearance = client.currentAppearance(); client.updateAppearance(appearance.themeMode, appearance.language === 'en-US' ? 'zh-CN' : 'en-US'); this.applyTheme() }, applyTheme() { const client = this.client as PteIMSDKClient; const appearance = client.currentAppearance(); this.language = appearance.language === 'en-US' ? 'en-US' : 'zh-CN'; const theme = (this.theme as PteIMUITheme | null) ?? new PteIMUITheme(); this.isDark = appearance.themeMode === 'dark' || (appearance.themeMode === 'system' && uni.getSystemInfoSync().theme === 'dark'); this.themeStyle = PteIMUITheme.cssVariables(PteIMUITheme.resolve(client, theme, this.isDark)) } },
}
</script>

<style>
.pte-im-ui-list { display: flex; height: 100%; flex-direction: column; background-color: var(--pte-im-ui-background); }
.pte-im-ui-list-nav { display: flex; min-height: 44px; align-items: center; justify-content: space-between; padding: 0 16px; background-color: var(--pte-im-ui-surface); border-bottom: 1px solid var(--pte-im-ui-divider); }.pte-im-ui-brand { display: flex; align-items: center; }.pte-im-ui-brand-logo { width: 28px; height: 28px; }.pte-im-ui-list-title { margin-left: 8px; color: var(--pte-im-ui-text); font-size: 18px; font-weight: 700; }.pte-im-ui-nav-actions { display: flex; gap: 6px; align-items: center; }.pte-im-ui-nav-actions button { display: flex; width: 30px; height: 44px; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background-color: transparent; }.pte-im-ui-nav-actions image { width: 20px; height: 20px; }
.pte-im-ui-search { display: flex; height: 40px; align-items: center; margin: 8px 16px 6px; padding: 0 12px; border-radius: 10px; background-color: var(--pte-im-ui-panel); color: var(--pte-im-ui-muted); }.pte-im-ui-search image { width: 17px; height: 17px; }.pte-im-ui-search input { flex: 1; min-width: 0; margin-left: 8px; color: var(--pte-im-ui-text); font-size: 14px; }
.pte-im-ui-list-scroll { flex: 1; min-height: 0; }.pte-im-ui-row { display: flex; min-height: 73px; align-items: center; padding: 8px 16px; border-bottom: 1px solid var(--pte-im-ui-divider); box-sizing: border-box; background-color: var(--pte-im-ui-background); }.pte-im-ui-avatar { display: flex; width: 42px; height: 42px; align-items: center; justify-content: center; border-radius: 21px; color: #FFFFFF; background-color: var(--pte-im-ui-outgoing-end); font-size: 15px; font-weight: 700; }.pte-im-ui-row-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 12px; }.pte-im-ui-name { overflow: hidden; color: var(--pte-im-ui-text); font-size: 15px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.pte-im-ui-preview { margin-top: 4px; overflow: hidden; color: var(--pte-im-ui-muted); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }.pte-im-ui-row-meta { align-self: flex-start; padding-top: 8px; color: var(--pte-im-ui-muted); font-size: 11px; }.pte-im-ui-empty { padding-top: 70px; color: var(--pte-im-ui-muted); font-size: 13px; text-align: center; }
</style>
