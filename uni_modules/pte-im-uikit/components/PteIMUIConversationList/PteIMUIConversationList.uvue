<template>
  <view class="pte-im-ui-list" :style="themeStyle">
    <view class="pte-im-ui-list-nav"><view class="pte-im-ui-brand"><view class="pte-im-ui-brand-orb"><text>◉</text></view><text class="pte-im-ui-list-title">{{ language === 'en-US' ? 'Chats' : '会话' }}</text></view><view class="pte-im-ui-nav-actions"><text @click="toggleAppearance">◐</text><text @click="toggleLanguage">◎</text><text @click="$emit('add')">＋</text></view></view>
    <view class="pte-im-ui-search"><text>⌕</text><input v-model="query" :placeholder="language === 'en-US' ? 'Search' : '搜索'" /></view>
    <scroll-view class="pte-im-ui-list-scroll" scroll-y="true"><view v-for="conversation in filteredConversations()" :key="conversation.conversationId" class="pte-im-ui-row" @click="$emit('select', conversation.conversationId)"><view class="pte-im-ui-avatar"><text>{{ avatar(conversation.conversationId) }}</text></view><view class="pte-im-ui-row-copy"><text class="pte-im-ui-name">{{ conversation.conversationId }}</text><text class="pte-im-ui-preview">{{ preview(conversation.lastMessage) }}</text></view><view class="pte-im-ui-row-meta"><text>{{ time(conversation.updatedAt) }}</text></view></view></scroll-view>
  </view>
</template>

<script lang="uts">
import { PteIMConversation, PteIMIncomingMessage, PteIMSDKClient } from '../../../pte-im-sdk/utssdk/interface.uts'
import { PteIMUIConversationListController, PteIMUIKit, PteIMUITheme } from '../../utssdk/PteIMUIKitFacade.uts'
export default {
  props: { client: { type: Object, required: true }, theme: { type: Object, default: null } }, emits: ['select', 'add'],
  data() { return { conversations: [] as PteIMConversation[], query: '', language: 'zh-CN', themeStyle: {} as any, controller: null as PteIMUIConversationListController | null } },
  mounted() { const controller = PteIMUIKit.createConversationListController(this.client as PteIMSDKClient); controller.onChanged = () => { this.conversations = controller.conversations; this.applyTheme() }; this.controller = controller; controller.refresh(); this.applyTheme() },
  beforeUnmount() { this.controller?.dispose() },
  methods: { preview(message: PteIMIncomingMessage): string { const value = message.content as any; const en = this.language === 'en-US'; if (message.type === 'text') return String(value.text ?? ''); if (message.type === 'image') return en ? '[Image]' : '[图片]'; if (message.type === 'voice') return en ? '[Voice]' : '[语音]'; if (message.type === 'red_packet') return en ? '[Red packet]' : '[红包]'; return '[' + message.type + ']' }, avatar(id: string): string { return id.length > 0 ? id.substring(0, 1).toUpperCase() : '?' }, time(value: number): string { const date = new Date(value); const today = new Date(); if (date.getFullYear() === today.getFullYear() && date.getMonth() === today.getMonth() && date.getDate() === today.getDate()) return String(date.getHours()).padStart(2, '0') + ':' + String(date.getMinutes()).padStart(2, '0'); return this.language === 'en-US' ? 'Yesterday' : '昨天' }, filteredConversations(): PteIMConversation[] { const query = this.query.trim().toLowerCase(); return query.length === 0 ? this.conversations : this.conversations.filter((item: PteIMConversation) => item.conversationId.toLowerCase().indexOf(query) >= 0 || this.preview(item.lastMessage).toLowerCase().indexOf(query) >= 0) }, toggleAppearance() { const client = this.client as PteIMSDKClient; const appearance = client.currentAppearance(); client.updateAppearance(appearance.themeMode === 'dark' ? 'light' : 'dark', appearance.language) }, toggleLanguage() { const client = this.client as PteIMSDKClient; const appearance = client.currentAppearance(); client.updateAppearance(appearance.themeMode, appearance.language === 'en-US' ? 'zh-CN' : 'en-US') }, applyTheme() { const client = this.client as PteIMSDKClient; const appearance = client.currentAppearance(); this.language = appearance.language === 'en-US' ? 'en-US' : 'zh-CN'; const theme = (this.theme as PteIMUITheme | null) ?? new PteIMUITheme(); const dark = appearance.themeMode === 'dark' || (appearance.themeMode === 'system' && uni.getSystemInfoSync().theme === 'dark'); this.themeStyle = PteIMUITheme.cssVariables(PteIMUITheme.resolve(client, theme, dark)) } },
}
</script>

<style>
.pte-im-ui-list { display: flex; height: 100%; flex-direction: column; background-color: var(--pte-im-ui-background); }
.pte-im-ui-list-nav { display: flex; min-height: 112rpx; align-items: center; justify-content: space-between; padding: 0 36rpx; background-color: var(--pte-im-ui-surface); }
.pte-im-ui-brand { display: flex; align-items: center; }.pte-im-ui-brand-orb { display: flex; width: 56rpx; height: 56rpx; align-items: center; justify-content: center; border-radius: 28rpx; color: #FFFFFF; background-image: linear-gradient(135deg, var(--pte-im-ui-outgoing-start), var(--pte-im-ui-outgoing-end)); }.pte-im-ui-list-title { margin-left: 16rpx; color: var(--pte-im-ui-text); font-size: 38rpx; font-weight: 700; }.pte-im-ui-nav-actions { display: flex; width: 152rpx; align-items: center; justify-content: space-between; color: var(--pte-im-ui-icon); font-size: 34rpx; }
.pte-im-ui-search { display: flex; height: 64rpx; align-items: center; margin: 18rpx 28rpx 10rpx; padding: 0 20rpx; border-radius: 32rpx; background-color: var(--pte-im-ui-surface); color: var(--pte-im-ui-muted); }.pte-im-ui-search input { flex: 1; min-width: 0; margin-left: 12rpx; color: var(--pte-im-ui-text); font-size: 26rpx; }
.pte-im-ui-list-scroll { flex: 1; min-height: 0; }.pte-im-ui-row { display: flex; min-height: 112rpx; align-items: center; padding: 12rpx 30rpx; border-bottom: 1px solid var(--pte-im-ui-divider); box-sizing: border-box; background-color: var(--pte-im-ui-background); }.pte-im-ui-avatar { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 38rpx; color: #FFFFFF; background-image: linear-gradient(135deg, var(--pte-im-ui-outgoing-start), var(--pte-im-ui-outgoing-end)); font-size: 29rpx; font-weight: 700; }.pte-im-ui-row-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 20rpx; }.pte-im-ui-name { overflow: hidden; color: var(--pte-im-ui-text); font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.pte-im-ui-preview { margin-top: 7rpx; overflow: hidden; color: var(--pte-im-ui-muted); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }.pte-im-ui-row-meta { align-self: flex-start; padding-top: 10rpx; color: var(--pte-im-ui-muted); font-size: 21rpx; }
</style>
