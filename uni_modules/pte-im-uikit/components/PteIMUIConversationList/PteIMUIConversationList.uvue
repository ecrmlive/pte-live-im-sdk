<template>
  <view :class="['pte-im-ui-list', { 'is-dark': isDark }]" :style="themeStyle">
    <view v-if="showNav" class="pte-im-ui-list-nav" :style="{ paddingRight: rightInset + 'px' }"><view class="pte-im-ui-brand"><image class="pte-im-ui-brand-logo" src="../../static/list/PteIMUIConversationLogo.png" mode="aspectFit" /><text class="pte-im-ui-list-title">{{ language === 'en-US' ? 'Chats' : '会话' }}</text></view><view class="pte-im-ui-nav-actions"><button @click="$emit('add')"><image v-if="isDark" src="../../static/list/PteIMUIConversationCreateDark.png" mode="aspectFit" /><image v-else src="../../static/list/PteIMUIConversationCreateLight.png" mode="aspectFit" /></button></view></view>
    <view class="pte-im-ui-search"><image src="../../static/list/PteIMUIConversationSearch.png" mode="aspectFit" /><input v-model="query" :placeholder="language === 'en-US' ? 'Search' : '搜索'" /></view>
    <scroll-view class="pte-im-ui-list-scroll" scroll-y="true" :refresher-enabled="true" :refresher-triggered="refreshing" :refresher-default-style="isDark ? 'white' : 'black'" refresher-background="transparent" @refresherrefresh="refreshList"><view v-for="conversation in filteredConversations()" :key="conversation.conversationId" class="pte-im-ui-row" @click="selectConversation(conversation)"><PteIMUIAvatar :src="String(conversation.avatar ?? '')" :label="avatar(conversation)" :size="44" :corner-radius="avatarCornerRadius" :background-color="avatarColor(conversation)" :online="isOnline(conversation)" /><view class="pte-im-ui-row-copy"><text class="pte-im-ui-name">{{ title(conversation) }}</text><text class="pte-im-ui-preview">{{ preview(conversation.lastMessage) }}</text></view><view class="pte-im-ui-row-meta"><text>{{ time(conversation) }}</text><text v-if="unreadCount(conversation) > 0" class="pte-im-ui-unread">{{ unreadCount(conversation) > 99 ? '99+' : unreadCount(conversation) }}</text></view></view><view v-if="filteredConversations().length === 0" class="pte-im-ui-empty"><text>{{ language === 'en-US' ? 'No conversations yet' : '暂无会话' }}</text></view></scroll-view>
  </view>
</template>

<script lang="uts">
import { PteIMConversation, PteIMIncomingMessage, PteIMSDKClient } from '../../../pte-im-sdk/utssdk/interface.uts'
import { PteIMUIConversationListController, PteIMUIKit, PteIMUITheme } from '../../utssdk/PteIMUIKitFacade.uts'
import PteIMUIAvatar from '../PteIMUIAvatar/PteIMUIAvatar.uvue'
export default {
  components: { PteIMUIAvatar },
  props: { client: { type: Object, required: true }, theme: { type: Object, default: null }, dark: { type: Boolean, default: false }, english: { type: Boolean, default: true }, showNav: { type: Boolean, default: true }, rightInset: { type: Number, default: 20 }, syncRevision: { type: Number, default: 0 }, avatarCornerRadius: { type: Number, default: -1 } }, emits: ['select', 'select-detail', 'unread-total', 'add'],
  data() { return { conversations: [] as PteIMConversation[], query: '', language: 'zh-CN', isDark: false, themeStyle: {} as any, controller: null as PteIMUIConversationListController | null, refreshing: false } },
  watch: { dark() { this.applyTheme() }, english() { this.applyTheme() }, syncRevision() { this.refreshList() } },
  mounted() { const controller = PteIMUIKit.createConversationListController(this.client as PteIMSDKClient); controller.onChanged = () => { this.conversations = controller.conversations; this.$emit('unread-total', this.unreadTotal()); this.applyTheme() }; this.controller = controller; controller.refresh(); this.applyTheme() },
  beforeUnmount() { this.controller?.dispose() },
  methods: { refreshList() { if (this.refreshing) return; this.refreshing = true; const client = this.client as PteIMSDKClient; client.syncNow(); client.syncConversationsNow(); this.controller?.refresh(); setTimeout(() => { this.refreshing = false; this.controller?.refresh() }, 800) }, selectConversation(conversation: PteIMConversation) { this.$emit('select', conversation.conversationId); this.$emit('select-detail', { conversationId: conversation.conversationId, title: this.title(conversation), avatar: String(conversation.avatar ?? '') }) }, preview(message: PteIMIncomingMessage): string { const value = message.content as any; const en = this.language === 'en-US'; if (message.type === 'text') return String(value.text ?? ''); if (message.type === 'image') return en ? '[Image]' : '[图片]'; if (message.type === 'voice') return en ? '[Voice]' : '[语音]'; if (message.type === 'red_packet') return en ? '[Red packet]' : '[红包]'; return '[' + message.type + ']' }, title(conversation: PteIMConversation): string { return String(conversation.title ?? conversation.conversationId) }, avatar(conversation: PteIMConversation): string { const value = this.title(conversation); return value.length > 0 ? value.substring(0, 1).toUpperCase() : '?' }, avatarColor(conversation: PteIMConversation): string { const colors = ['#8757F6', '#0798BA', '#009A6F', '#E78000', '#D82571', '#7639E8']; const value = String(conversation.conversationId); return colors[value.length % colors.length] }, avatarRadius(size: number): number { const custom = Number(this.avatarCornerRadius); return Math.max(0, Math.min(custom >= 0 ? custom : size / 2, size / 2)) }, unreadCount(conversation: PteIMConversation): number { return Math.max(0, Number(conversation.unreadCount ?? 0)) }, unreadTotal(): number { let result = 0; this.conversations.forEach((conversation: PteIMConversation): void => { result += this.unreadCount(conversation) }); return result }, isOnline(conversation: PteIMConversation): boolean { return Boolean((conversation as any).online) }, time(conversation: PteIMConversation): string { const value = new Date(conversation.updatedAt); return String(value.getHours()).padStart(2, '0') + ':' + String(value.getMinutes()).padStart(2, '0') }, filteredConversations(): PteIMConversation[] { const query = this.query.trim().toLowerCase(); return query.length === 0 ? this.conversations : this.conversations.filter((item: PteIMConversation) => this.title(item).toLowerCase().indexOf(query) >= 0 || this.preview(item.lastMessage).toLowerCase().indexOf(query) >= 0) }, applyTheme() { const client = this.client as PteIMSDKClient; this.language = Boolean(this.english) ? 'en-US' : 'zh-CN'; const theme = (this.theme as PteIMUITheme | null) ?? new PteIMUITheme(); this.isDark = Boolean(this.dark); this.themeStyle = PteIMUITheme.cssVariables(PteIMUITheme.resolve(client, theme, this.isDark)) } },
}
</script>

<style>
.pte-im-ui-list { display: flex; height: 100%; flex-direction: column; background-color: var(--pte-im-ui-background); }
.pte-im-ui-list-nav { display: flex; flex-direction: row; min-height: 44px; align-items: center; justify-content: space-between; padding: 0 16px; background-color: var(--pte-im-ui-surface); border-bottom: 1px solid var(--pte-im-ui-divider); }.pte-im-ui-brand { display: flex; flex-direction: row; align-items: center; }.pte-im-ui-brand-logo { width: 28px; height: 28px; }.pte-im-ui-list-title { margin-left: 8px; color: var(--pte-im-ui-text); font-size: 18px; font-weight: 700; }.pte-im-ui-nav-actions { display: flex; flex-direction: row; gap: 6px; align-items: center; }.pte-im-ui-nav-actions button { display: flex; width: 30px; height: 44px; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background-color: transparent; }.pte-im-ui-nav-actions image { width: 20px; height: 20px; }
.pte-im-ui-search { display: flex; flex-direction: row; height: 40px; align-items: center; margin: 8px 16px 6px; padding: 0 12px; border-radius: 10px; background-color: var(--pte-im-ui-panel); color: var(--pte-im-ui-muted); }.pte-im-ui-search image { width: 17px; height: 17px; }.pte-im-ui-search input { flex: 1; min-width: 0; margin-left: 8px; color: var(--pte-im-ui-text); font-size: 14px; }
.pte-im-ui-list-scroll { position:relative; flex:1; min-height:0; }.pte-im-ui-row { display: flex; flex-direction: row; min-height: 73px; align-items: center; padding: 8px 16px; border-bottom: 1px solid var(--pte-im-ui-divider); box-sizing: border-box; background-color: var(--pte-im-ui-background); }.pte-im-ui-avatar { position: relative; display: flex; width: 42px; height: 42px; align-items: center; justify-content: center; border-radius: 21px; color: #FFFFFF; font-size: 15px; font-weight: 700; }.pte-im-ui-online-dot { position: absolute; right: 0; bottom: 0; width: 11px; height: 11px; border: 2px solid var(--pte-im-ui-background); border-radius: 8px; background-color: #16C784; box-sizing: border-box; }.pte-im-ui-row-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; margin-left: 12px; }.pte-im-ui-name { overflow: hidden; color: var(--pte-im-ui-text); font-size: 15px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.pte-im-ui-preview { margin-top: 4px; overflow: hidden; color: var(--pte-im-ui-muted); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }.pte-im-ui-row-meta { display: flex; min-width: 22px; align-self: flex-start; padding-top: 8px; align-items: flex-end; flex-direction: column; color: var(--pte-im-ui-muted); font-size: 11px; }.pte-im-ui-unread { display: flex; min-width: 18px; height: 18px; align-items: center; justify-content: center; margin-top: 5px; padding: 0 4px; border-radius: 10px; box-sizing: border-box; color: #FFFFFF; background-color: #E9344E; font-size: 10px; font-weight: 700; }.pte-im-ui-empty { position:absolute; top:50%; left:0; right:0; display:flex; align-items:center; justify-content:center; transform:translateY(-50%); color:var(--pte-im-ui-muted); font-size:13px; text-align:center; }
.pte-im-ui-list button { border:0; outline:0; box-shadow:none; -webkit-appearance:none; appearance:none; }.pte-im-ui-list button::after { border: 0; }
.pte-im-ui-list-nav { min-height: 44px; padding: 0 20px; }
.pte-im-ui-nav-actions { gap: 0; }
.pte-im-ui-nav-actions button { width: 44px; height: 44px; }.pte-im-ui-nav-actions image { width:44px; height:44px; }
.pte-im-ui-search { height: 40px; margin: 6px 20px 12px; padding: 0 14px; border: 1px solid #CEC8EC; border-radius: 14px; background-color: #E4E1F8; }
.is-dark .pte-im-ui-search { border-color: #211E4C; background-color: #211E4C; }
.pte-im-ui-row { min-height: 72px; padding-right: 20px; padding-left: 20px; }.pte-im-ui-row-meta { min-width:52px; }.pte-im-ui-unread { min-width:18px; }
.pte-im-ui-avatar { width: 44px; height: 44px; border-radius: 22px; }
.pte-im-ui-avatar image { display:block; width:44px; height:44px; overflow:hidden; border-radius:22px; object-fit:cover; }
</style>
