<template>
  <view class="pte-im-ui-input-root" :class="dark ? 'is-dark' : ''">
    <view class="pte-im-ui-composer-row">
      <button class="pte-im-ui-composer-icon" @click="toggleVoice"><image v-if="voiceMode && dark" src="../../static/chat/keyboard-dark.png" mode="aspectFit" /><image v-else-if="voiceMode" src="../../static/chat/keyboard-light.png" mode="aspectFit" /><image v-else-if="dark" src="../../static/chat/voice-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/voice-light.png" mode="aspectFit" /></button>

      <button v-if="voiceMode" class="pte-im-ui-hold-to-talk" :class="{ 'is-recording': recording && !recordingCancelled, 'is-cancelled': recording && recordingCancelled }" @touchstart="beginVoice" @touchmove="moveVoice" @touchend="finishVoice" @touchcancel="cancelVoice" @touchleave="leaveVoice" @mousedown="beginVoice" @mousemove="moveVoice" @mouseup="finishVoice" @mouseleave="leaveVoice">
        {{ recording ? (recordingCancelled ? copy('releaseCancel') : copy('speaking')) : copy('hold') }}
      </button>
      <view v-else class="pte-im-ui-text-input-shell" :style="{ height: textareaHeight + 'px' }"><textarea v-model="draftValue" class="pte-im-ui-textarea" :class="{ 'is-scrollable': textareaHeight >= 100 }" :style="{ height: textareaHeight + 'px' }" :maxlength="maxLength" :placeholder="copy('message')" confirm-type="send" :show-confirm-bar="false" @input="onTextInput" @confirm="sendText" /></view>
      <button v-if="!voiceMode" class="pte-im-ui-composer-icon" @click="toggleEmoji"><image v-if="mode === 'emoji' && dark" src="../../static/chat/keyboard-emoji-dark.png" mode="aspectFit" /><image v-else-if="mode === 'emoji'" src="../../static/chat/keyboard-emoji-light.png" mode="aspectFit" /><image v-else-if="dark" src="../../static/chat/emoji-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/emoji-light.png" mode="aspectFit" /></button>
      <button class="pte-im-ui-composer-icon" @click="toggleMore"><image v-if="mode === 'more' && dark" src="../../static/chat/close-dark.png" mode="aspectFit" /><image v-else-if="mode === 'more'" src="../../static/chat/close-light.png" mode="aspectFit" /><image v-else-if="dark" src="../../static/chat/more-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/more-light.png" mode="aspectFit" /></button>
    </view>

    <view v-if="mode === 'emoji'" class="pte-im-ui-panel pte-im-ui-emoji-panel">
      <view class="pte-im-ui-emoji-tabs">
        <button :class="['pte-im-ui-emoji-tab', { selected: emojiGroup === 'common' }]" @click="emojiGroup = 'common'">{{ copy('common') }}</button>
        <button :class="['pte-im-ui-emoji-tab', { selected: emojiGroup === 'all' }]" @click="emojiGroup = 'all'">{{ copy('all') }}</button>
      </view>
      <scroll-view class="pte-im-ui-emoji-scroll" scroll-y="true">
        <view class="pte-im-ui-emoji-grid">
          <button v-for="item in visibleEmojis()" :key="item.id" class="pte-im-ui-emoji-cell" @click="insertEmoji(item)">
            <image v-if="item.imageUrl" class="pte-im-ui-emoji-image" :src="item.imageUrl" mode="aspectFit" />
            <text v-else>{{ item.value }}</text>
          </button>
        </view>
      </scroll-view>
      <view class="pte-im-ui-panel-footer">
        <button class="pte-im-ui-panel-control" @click="backspace"><image v-if="dark" src="../../static/chat/backspace-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/backspace-light.png" mode="aspectFit" /></button>
        <button class="pte-im-ui-panel-send" :disabled="draftValue.trim().length === 0" @click="sendText"><image v-if="dark" src="../../static/chat/send-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/send-light.png" mode="aspectFit" /></button>
      </view>
    </view>

    <view v-if="mode === 'more'" class="pte-im-ui-panel pte-im-ui-more-panel">
      <view class="pte-im-ui-more-grid">
        <button v-for="item in visibleActions()" :key="actionKey(item)" class="pte-im-ui-more-cell" @click="pickAction(item)">
          <image v-if="typeof item !== 'string'" class="pte-im-ui-more-icon" :src="item.iconUrl" mode="aspectFit" />
          <image v-else-if="item === 'image'" class="pte-im-ui-more-icon" src="../../static/chat/action-image.png" mode="aspectFit" />
          <image v-else-if="item === 'camera'" class="pte-im-ui-more-icon" src="../../static/chat/action-camera.png" mode="aspectFit" />
          <image v-else-if="item === 'video'" class="pte-im-ui-more-icon" src="../../static/chat/action-video.png" mode="aspectFit" />
          <image v-else-if="item === 'location'" class="pte-im-ui-more-icon" src="../../static/chat/action-location.png" mode="aspectFit" />
          <image v-else-if="item === 'file'" class="pte-im-ui-more-icon" src="../../static/chat/action-file.png" mode="aspectFit" />
          <image v-else-if="item === 'red_packet'" class="pte-im-ui-more-icon" src="../../static/chat/action-red-packet.png" mode="aspectFit" />
          <image v-else-if="item === 'gift'" class="pte-im-ui-more-icon" src="../../static/chat/action-gift.png" mode="aspectFit" />
          <image v-else class="pte-im-ui-more-icon" src="../../static/chat/action-order.png" mode="aspectFit" />
          <text>{{ actionTitle(item) }}</text>
        </button>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { PteIMUIAction, PteIMUICustomAction, PteIMUIEmoji, PteIMUIInputAction } from '../../utssdk/PteIMUIKitFacade.uts'

export default {
  props: {
    modelValue: { type: String, default: '' }, language: { type: String, default: 'zh-CN' }, dark: { type: Boolean, default: false },
    maxLength: { type: Number, default: 200 }, emojis: { type: Array, default: () => [] as PteIMUIEmoji[] }, customActions: { type: Array, default: () => [] as PteIMUICustomAction[] }, dismissRevision: { type: Number, default: 0 }
  },
  emits: ['update:modelValue', 'send', 'action', 'voice-recording'],
  data() {
    return {
      draftValue: this.modelValue as string, mode: 'keyboard', voiceMode: false, recording: false, recordingCancelled: false, voiceStartX: 0, voiceStartY: 0, voiceStartedAt: 0, emojiGroup: 'common', textareaHeight: 40,
      defaultEmojis: [
        { id: 'grin', value: '😀', group: 'common' }, { id: 'smile', value: '😊', group: 'common' }, { id: 'laugh', value: '😂', group: 'common' }, { id: 'heart', value: '❤️', group: 'common' }, { id: 'thumbs-up', value: '👍', group: 'common' }, { id: 'wave', value: '👋', group: 'common' }, { id: 'wink', value: '😉', group: 'common' }, { id: 'kiss', value: '😘', group: 'common' }, { id: 'party', value: '🥳', group: 'common' }, { id: 'fire', value: '🔥', group: 'common' },
        { id: 'sad', value: '😢', group: 'all' }, { id: 'angry', value: '😠', group: 'all' }, { id: 'surprised', value: '😮', group: 'all' }, { id: 'ok', value: '👌', group: 'all' }, { id: 'clap', value: '👏', group: 'all' }, { id: 'rose', value: '🌹', group: 'all' }, { id: 'cool', value: '😎', group: 'all' }, { id: 'thinking', value: '🤔', group: 'all' }, { id: 'cry', value: '😭', group: 'all' }, { id: 'sunglasses', value: '🕶️', group: 'all' }, { id: 'eyes', value: '😍', group: 'all' }, { id: 'halo', value: '😇', group: 'all' }, { id: 'sleep', value: '😴', group: 'all' }, { id: 'poop', value: '💩', group: 'all' }, { id: 'hundred', value: '💯', group: 'all' }, { id: 'sparkles', value: '✨', group: 'all' }, { id: 'star', value: '⭐', group: 'all' }, { id: 'rocket', value: '🚀', group: 'all' }, { id: 'coffee', value: '☕', group: 'all' }, { id: 'gift', value: '🎁', group: 'all' }, { id: 'check', value: '✅', group: 'all' }, { id: 'cross', value: '❌', group: 'all' }, { id: 'question', value: '❓', group: 'all' }, { id: 'exclamation', value: '❗', group: 'all' }, { id: 'music', value: '🎵', group: 'all' }, { id: 'balloon', value: '🎈', group: 'all' }, { id: 'flower', value: '🌸', group: 'all' }, { id: 'sun', value: '☀️', group: 'all' }, { id: 'moon', value: '🌙', group: 'all' }, { id: 'rainbow', value: '🌈', group: 'all' },
      ] as PteIMUIEmoji[],
      builtInActions: ['image', 'camera', 'video', 'location', 'file', 'red_packet', 'gift', 'order'] as PteIMUIAction[],
    }
  },
  watch: { modelValue(value: string) { if (value !== this.draftValue) this.draftValue = value }, draftValue(value: string) { this.$emit('update:modelValue', value); if (value.length === 0) this.textareaHeight = 40 }, dismissRevision(_value: number) { this.dismissTransientUI() } },
  methods: {
    dismissTransientUI() { if (this.recording) this.emitVoiceState(false, true, Math.max(0, Date.now() - this.voiceStartedAt), false); this.mode = 'keyboard'; this.voiceMode = false; this.recording = false; this.recordingCancelled = false },
    onTextInput(event: any) { const value = String(event?.detail?.value ?? this.draftValue); const eventLines = Number(event?.detail?.lineCount ?? 0); const lineCount = eventLines > 0 ? eventLines : value.split('\n').length; this.textareaHeight = Math.min(100, Math.max(40, lineCount * 24 + 16)) },
    toggleVoice() { this.voiceMode = !this.voiceMode; this.mode = 'keyboard'; this.recording = false; this.recordingCancelled = false },
    toggleEmoji() { this.mode = this.mode === 'emoji' ? 'keyboard' : 'emoji'; this.voiceMode = false },
    toggleMore() { this.mode = this.mode === 'more' ? 'keyboard' : 'more'; this.voiceMode = false },
    beginVoice(event: any) { if (this.recording) return; const touch = event?.touches?.[0] ?? event?.changedTouches?.[0] ?? event; this.voiceStartX = Number(touch?.clientX ?? touch?.pageX ?? 0); this.voiceStartY = Number(touch?.clientY ?? touch?.pageY ?? 0); this.voiceStartedAt = Date.now(); this.recording = true; this.recordingCancelled = false; this.emitVoiceState(true, false) },
    moveVoice(event: any) { if (!this.recording) return; const touch = event?.touches?.[0] ?? event?.changedTouches?.[0] ?? event; const x = Number(touch?.clientX ?? touch?.pageX ?? this.voiceStartX); const y = Number(touch?.clientY ?? touch?.pageY ?? this.voiceStartY); const target = event.currentTarget as any; const rect = target?.getBoundingClientRect?.(); const cancelled = rect != null ? x < Number(rect.left) || x > Number(rect.right) || y < Number(rect.top) || y > Number(rect.bottom) : Math.abs(x - this.voiceStartX) > 56 || Math.abs(y - this.voiceStartY) > 56; if (cancelled === this.recordingCancelled) return; this.recordingCancelled = cancelled; this.emitVoiceState(true, cancelled) },
    leaveVoice() { if (!this.recording || this.recordingCancelled) return; this.recordingCancelled = true; this.emitVoiceState(true, true) },
    finishVoice() { if (!this.recording) return; const durationMs = Math.max(0, Date.now() - this.voiceStartedAt); const tooShort = !this.recordingCancelled && durationMs < 1000; const cancelled = this.recordingCancelled || tooShort; this.recording = false; this.recordingCancelled = false; this.emitVoiceState(false, cancelled, durationMs, tooShort) },
    cancelVoice() { if (!this.recording) return; const durationMs = Math.max(0, Date.now() - this.voiceStartedAt); this.recording = false; this.recordingCancelled = false; this.emitVoiceState(false, true, durationMs, false) },
    emitVoiceState(recording: boolean, cancelled: boolean, durationMs: number = 0, tooShort: boolean = false) { this.$emit('voice-recording', { recording, cancelled, durationMs, tooShort }) },
    visibleEmojis(): PteIMUIEmoji[] { const source = (this.emojis as PteIMUIEmoji[]).length > 0 ? this.emojis as PteIMUIEmoji[] : this.defaultEmojis; return this.emojiGroup === 'common' ? source.filter((item: PteIMUIEmoji) => item.group !== 'all') : source },
    visibleActions(): PteIMUIInputAction[] { const all = (this.builtInActions as PteIMUIInputAction[]).concat(this.customActions as PteIMUICustomAction[]); return all.slice(0, 12) },
    insertEmoji(item: PteIMUIEmoji) { if (this.draftValue.length + item.value.length > Number(this.maxLength)) return; this.draftValue += item.value },
    backspace() { if (this.draftValue.length > 0) this.draftValue = this.draftValue.substring(0, this.draftValue.length - 1) },
    sendText() { const value = this.draftValue.trim(); if (value.length === 0) return; this.$emit('send', value); this.draftValue = ''; this.mode = 'keyboard' },
    actionKey(item: PteIMUIInputAction): string { return typeof item === 'string' ? item : item.id },
    actionTitle(item: PteIMUIInputAction): string { if (typeof item !== 'string') return item.title; return this.copy(item) },
    pickAction(item: PteIMUIInputAction) { this.mode = 'keyboard'; this.$emit('action', item) },
    copy(key: string): string { const en = this.language === 'en-US'; if (key === 'message') return en ? 'Say something' : '说点什么'; if (key === 'hold') return en ? 'Hold to talk' : '按住说话'; if (key === 'speaking') return en ? 'Speaking…' : '正在说话'; if (key === 'releaseCancel') return en ? 'Release to cancel' : '松开手取消录音'; if (key === 'common') return en ? 'Recent' : '常用表情'; if (key === 'all') return en ? 'All' : '全部表情'; if (key === 'image') return en ? 'Image' : '图片'; if (key === 'camera') return en ? 'Camera' : '相机'; if (key === 'video') return en ? 'Video' : '视频'; if (key === 'location') return en ? 'Location' : '定位'; if (key === 'file') return en ? 'File' : '文件'; if (key === 'gift') return en ? 'Gift' : '礼物'; if (key === 'red_packet') return en ? 'Red Packet' : '红包'; return en ? 'Order' : '订单' },
  },
}
</script>

<style>
.pte-im-ui-input-root { background-color: var(--pte-im-ui-composer); border-top: 1px solid var(--pte-im-ui-divider); }.pte-im-ui-input-root button { border:0; outline:0; box-shadow:none; -webkit-appearance:none; appearance:none; }.pte-im-ui-composer-row { display: flex; flex-direction: row; align-items: flex-end; min-height: 56px; padding: 8px 12px; box-sizing: border-box; }.pte-im-ui-composer-icon { display: flex; width: 40px; min-width: 40px; height: 40px; align-items: center; justify-content: center; margin: 0; padding: 2px; border: 0; background-color: transparent; }.pte-im-ui-composer-icon image { width: 36px; height: 36px; }
.pte-im-ui-text-input-shell, .pte-im-ui-hold-to-talk { display: flex; flex: 1; min-width: 0; min-height: 40px; max-height: 100px; margin: 0 4px; border: 0; border-radius: 10px; box-sizing: border-box; color: var(--pte-im-ui-text); background-color: var(--pte-im-ui-composer-input); }.pte-im-ui-text-input-shell { flex-direction: row; align-items: flex-end; }.pte-im-ui-textarea { display:block; flex: 1; min-width: 0; min-height: 40px; max-height: 100px; padding: 8px 10px; border: 0; box-sizing: border-box; resize:none; color: var(--pte-im-ui-text); background-color: transparent; font-size: 14px; line-height: 24px; overflow-y: hidden; scrollbar-width: none; -ms-overflow-style: none; }.pte-im-ui-textarea::-webkit-scrollbar { width: 0; height: 0; display: none; }.pte-im-ui-textarea.is-scrollable { overflow-y: auto; }.pte-im-ui-hold-to-talk { height: 40px; padding: 0 10px; color: var(--pte-im-ui-text); font-size: 14px; line-height: 40px; text-align: center; transition: background-color .12s ease, color .12s ease; }.pte-im-ui-hold-to-talk.is-recording { color: #FFFFFF; background-color: var(--pte-im-ui-outgoing-end); }.pte-im-ui-hold-to-talk.is-cancelled { color: #FFFFFF; background-color: #FA4D50; }
.pte-im-ui-panel { border-top: 1px solid var(--pte-im-ui-divider); background-color: var(--pte-im-ui-panel); }.pte-im-ui-emoji-panel { height: 338px; display: flex; flex-direction: column; }.pte-im-ui-emoji-tabs { display: flex; flex-direction: row; height: 42px; padding: 0 12px; border-bottom: 1px solid var(--pte-im-ui-divider); }.pte-im-ui-emoji-tab { height: 42px; margin: 0 14px 0 0; padding: 0 8px; border: 0; border-bottom: 2px solid transparent; color: var(--pte-im-ui-muted); background: transparent; font-size: 12px; }.pte-im-ui-emoji-tab.selected { border-bottom-color: var(--pte-im-ui-outgoing-end); color: var(--pte-im-ui-outgoing-end); font-weight: 600; }.pte-im-ui-emoji-scroll { flex: 1; min-height: 0; }.pte-im-ui-emoji-grid { display: flex; flex-direction: row; flex-wrap: wrap; padding: 8px 10px; }.pte-im-ui-emoji-cell { display: flex; width: 44px; height: 44px; align-items: center; justify-content: center; margin: 1px; padding: 0; border: 0; color: var(--pte-im-ui-text); background: transparent; font-size: 24px; }.pte-im-ui-emoji-image { width: 24px; height: 32px; }.pte-im-ui-panel-footer { display: flex; flex-direction: row; height: 52px; align-items: center; justify-content: flex-end; padding: 0 12px; border-top: 1px solid var(--pte-im-ui-divider); }.pte-im-ui-panel-control, .pte-im-ui-panel-send { display: flex; width: 44px; height: 40px; align-items: center; justify-content: center; margin: 0 0 0 10px; padding: 0; border: 0; background: transparent; }.pte-im-ui-panel-control image { width: 32px; height: 28px; }.pte-im-ui-panel-send image { width: 40px; height: 36px; }.pte-im-ui-panel-send:disabled { opacity: .4; }
.pte-im-ui-more-panel { padding: 14px 18px 24px; }.pte-im-ui-more-grid { display: flex; flex-direction: row; flex-wrap: wrap; }.pte-im-ui-more-cell { display: flex; width: 25%; min-width: 0; height: 94px; flex-direction: column; align-items: center; justify-content: flex-start; margin: 0; padding: 0; border: 0; color: var(--pte-im-ui-muted); background: transparent; font-size: 11px; }.pte-im-ui-more-icon { width: 52px; height: 52px; margin-bottom: 6px; }
.pte-im-ui-input-root button::after { border: 0; }
</style>
