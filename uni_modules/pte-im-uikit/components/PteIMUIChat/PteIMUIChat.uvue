<template>
  <view class="pte-im-ui-chat" :class="themeClass" :style="themeStyle">
    <view class="pte-im-ui-navigation" :style="{ paddingRight: rightInset + 'px' }">
      <button class="pte-im-ui-navigation-button" @click="$emit('back')"><image v-if="isDark" src="../../static/chat/nav-back-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/nav-back-light.svg" mode="aspectFit" /></button><view class="pte-im-ui-navigation-avatar"><image v-if="avatarURLForId(headerAvatarId).length > 0" :src="avatarURLForId(headerAvatarId)" mode="aspectFill" /><text v-else>{{ title.indexOf('Team') >= 0 || title.indexOf('群') >= 0 ? '#' : 'A' }}</text></view>
      <view class="pte-im-ui-navigation-title-wrap"><text class="pte-im-ui-title">{{ title || conversationId }}</text><text class="pte-im-ui-subtitle">{{ subtitle || (language === 'en-US' ? 'Online' : '在线') }}</text></view>
      <view class="pte-im-ui-navigation-actions"><button class="pte-im-ui-navigation-button" @click="$emit('more')"><image v-if="isDark" src="../../static/chat/nav-more-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/nav-more-light.svg" mode="aspectFit" /></button></view>
    </view>

    <scroll-view class="pte-im-ui-messages" scroll-y="true" :enhanced="true" :show-scrollbar="true" :scroll-into-view="latestMessageId" :refresher-enabled="true" :refresher-triggered="historyLoading" :refresher-default-style="isDark ? 'white' : 'black'" refresher-background="transparent" @refresherrefresh="loadOlderMessages" @click="dismissTransientUI" @touchmove="dismissTransientUI"><view v-if="messages.length > 0" class="pte-im-ui-day-divider"><view></view><text>{{ language === 'en-US' ? 'Today' : '今天' }}</text><view></view></view>
      <view v-for="message in messages" :id="message.clientMsgId" :key="message.clientMsgId" class="pte-im-ui-message-row" :class="isOutgoing(message) ? 'pte-im-ui-outgoing-row' : 'pte-im-ui-incoming-row'">
        <view class="pte-im-ui-avatar"><image v-if="avatarURLForId(message.senderId ?? '').length > 0" :src="avatarURLForId(message.senderId ?? '')" mode="aspectFill" /><text v-else>{{ avatar(message) }}</text></view>
        <view class="pte-im-ui-message-stack" :class="isOutgoing(message) ? 'pte-im-ui-stack-outgoing' : 'pte-im-ui-stack-incoming'">
          <view v-if="selectedMessageId === message.clientMsgId" class="pte-im-ui-message-actions"><button v-for="emoji in quickReactions" :key="emoji" :class="reactionSelected(message, emoji) ? 'is-selected' : ''" @click="toggleReaction(message, emoji)">{{ emoji }}</button></view>
          <view v-if="selectedMessageId === message.clientMsgId" class="pte-im-ui-message-actions pte-im-ui-message-tools"><button @click="performMessageAction('quote', message)"><image v-if="isDark" src="../../static/chat/quote-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/quote-light.png" mode="aspectFit" /><text>{{ copy('quote') }}</text></button><button @click="performMessageAction('copy', message)"><image v-if="isDark" src="../../static/chat/copy-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/copy-light.png" mode="aspectFit" /><text>{{ copy('copy') }}</text></button><button v-if="isOutgoing(message)" @click="performMessageAction('revoke', message)"><image v-if="isDark" src="../../static/chat/revoke-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/revoke-light.png" mode="aspectFit" /><text>{{ copy('revoke') }}</text></button><button class="pte-im-ui-message-delete" @click="performMessageAction('delete', message)"><image v-if="isDark" src="../../static/chat/delete-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/delete-light.png" mode="aspectFit" /><text>{{ copy('delete') }}</text></button></view>
          <view class="pte-im-ui-message" :class="[isOutgoing(message) ? 'pte-im-ui-outgoing' : 'pte-im-ui-incoming', richType(message)]" @click="dismissTransientUI" @longpress="showMessageMenu(message)">
            <view v-if="String(message.quoteSnapshot ?? '').length > 0" class="pte-im-ui-inline-quote"><text>{{ String(message.quoteSnapshot) }}</text></view>
            <text v-if="message.status === 2" class="pte-im-ui-message-text pte-im-ui-recalled">{{ copy('recalled') }}</text>
            <text v-else-if="message.type === 'text' || message.type === 'emoji'" class="pte-im-ui-message-text">{{ messageText(message) }}</text>
            <view v-else-if="message.type === 'image'" class="pte-im-ui-photo-card" @click="previewImage(message)" @longpress="saveImage(message)"><image v-if="mediaURL(message).length > 0" class="pte-im-ui-media-image" :src="mediaURL(message)" mode="aspectFill" /><view v-else class="pte-im-ui-photo-placeholder"><image src="../../static/chat/photo-icon.png" mode="aspectFit" /><text>{{ language === 'en-US' ? 'Photo' : '照片' }}</text></view></view>
            <view v-else-if="message.type === 'video'" class="pte-im-ui-video-card" @click="previewVideo(message)"><image v-if="videoPoster(message).length > 0 || mediaURL(message).length > 0" class="pte-im-ui-video-cover" :src="videoPoster(message) || mediaURL(message)" mode="aspectFill" /><view v-else class="pte-im-ui-video-placeholder"></view><view class="pte-im-ui-video-play"><image src="../../static/chat/video-play.png" mode="aspectFit" /></view><view class="pte-im-ui-video-duration"><image src="../../static/chat/video-duration.png" mode="aspectFit" /><view class="pte-im-ui-video-duration-copy"><text>{{ videoDuration(message) }}</text></view></view></view>
            <view v-else-if="message.type === 'voice' && isOutgoing(message)" class="pte-im-ui-voice-card pte-im-ui-voice-outgoing" @click="playVoice(message)"><text>{{ voiceDuration(message) }}</text><image v-if="isDark" src="../../static/chat/voice-dark-outgoing.png" mode="aspectFit" /><image v-else src="../../static/chat/voice-light-outgoing.png" mode="aspectFit" /></view>
            <view v-else-if="message.type === 'voice'" class="pte-im-ui-voice-card pte-im-ui-voice-incoming" @click="playVoice(message)"><image v-if="isDark" src="../../static/chat/voice-dark-incoming.png" mode="aspectFit" /><image v-else src="../../static/chat/voice-light-incoming.png" mode="aspectFit" /><text>{{ voiceDuration(message) }}</text></view>
            <view v-else-if="message.type === 'location'" class="pte-im-ui-location-card" @click="openLocation(message)"><image src="../../static/chat/location-map.png" mode="aspectFill" /><view><text class="pte-im-ui-card-title">{{ content(message).name || copy('location') }}</text><text>{{ content(message).address || '' }}</text></view></view>
            <view v-else-if="message.type === 'file'" class="pte-im-ui-file-card" @click="openFile(message)" @longpress="saveFile(message)"><image class="pte-im-ui-file-icon" src="../../static/chat/file-message.png" mode="aspectFit" /><view class="pte-im-ui-file-copy"><text class="pte-im-ui-card-title">{{ content(message).fileName || copy('file') }}</text><text>{{ fileSize(message) }}</text></view></view>
            <view v-else-if="message.type === 'red_packet'" class="pte-im-ui-red-packet-card" @click="$emit('business-action', message)"><image src="../../static/chat/red-packet-card.png" mode="aspectFill" /><view><text>{{ content(message).title || (language === 'en-US' ? 'Red packet' : '红包') }}</text><text>{{ content(message).subtitle || (language === 'en-US' ? 'Open to view details' : '点击查看详情') }}</text><text>★ {{ language === 'en-US' ? 'Received' : '已领取' }} ★</text></view></view>
            <view v-else-if="message.type === 'gift'" class="pte-im-ui-red-packet-card" @click="$emit('business-action', message)"><image src="../../static/chat/gift-card.png" mode="aspectFill" /><view><text>{{ content(message).title || (language === 'en-US' ? 'Gift' : '礼物') }}</text><text>{{ content(message).subtitle || (language === 'en-US' ? 'Open to view details' : '点击查看详情') }}</text><text>★ {{ language === 'en-US' ? 'Received' : '已领取' }} ★</text></view></view>
            <view v-else-if="message.type === 'order'" class="pte-im-ui-order-card" @click="$emit('business-action', message)"><view class="pte-im-ui-order-main"><view class="pte-im-ui-order-icon"><image src="../../static/chat/order-icon.png" mode="aspectFit" /></view><view><text class="pte-im-ui-card-title">{{ content(message).title || businessTitle(message) }}</text><text class="pte-im-ui-order-price">{{ content(message).subtitle || '' }}</text></view></view><view class="pte-im-ui-order-footer"><text>{{ language === 'en-US' ? 'Order' : '订单' }}</text><text>{{ language === 'en-US' ? 'View Order ›' : '查看订单 ›' }}</text></view></view>
            <view v-else class="pte-im-ui-business-card" @click="$emit('business-action', message)"><text class="pte-im-ui-card-title">{{ businessTitle(message) }}</text><text>{{ content(message).subtitle || '' }}</text></view>
          </view>
          <view v-if="reactions(message).length > 0" class="pte-im-ui-reactions"><button v-for="reaction in reactions(message)" :key="reaction.emoji" class="pte-im-ui-reaction" @click="requestReaction(message, reaction.emoji)">{{ reaction.emoji }} {{ reaction.count }}</button></view>
          <view class="pte-im-ui-delivery"><text>{{ timestamp(message) }}</text><button v-if="isOutgoing(message) && deliveryState(message) === 'failed'" class="pte-im-ui-retry" @click="performMessageAction('retry', message)">{{ copy('retry') }}</button><text v-else-if="isOutgoing(message) && (deliveryState(message) === 'uploading' || deliveryState(message) === 'pending')">{{ deliveryCopy(message) }}</text><image v-else-if="isOutgoing(message) && isRead(message) && isDark" class="pte-im-ui-read-icon" src="../../static/list/PteIMUIChatReadDark.png" mode="aspectFit" /><image v-else-if="isOutgoing(message) && isRead(message)" class="pte-im-ui-read-icon" src="../../static/list/PteIMUIChatReadLight.png" mode="aspectFit" /><image v-else-if="isOutgoing(message) && isDark" class="pte-im-ui-read-icon" src="../../static/list/PteIMUIChatUnreadDark.png" mode="aspectFit" /><image v-else-if="isOutgoing(message)" class="pte-im-ui-read-icon" src="../../static/list/PteIMUIChatUnreadLight.png" mode="aspectFit" /></view>
        </view>
      </view>
    </scroll-view>

    <view v-if="quotedMessage != null" class="pte-im-ui-quote-bar"><view><text class="pte-im-ui-quote-name">{{ copy('quote') }}</text><text>{{ messageText(quotedMessage) }}</text></view><button @click="quotedMessage = null"><image v-if="isDark" src="../../static/chat/close-dark.png" mode="aspectFit" /><image v-else src="../../static/chat/close-light.png" mode="aspectFit" /></button></view>
    <PteIMUIInputBar v-model="draft" :language="language" :dark="isDark" :emojis="emojis" :custom-actions="customActions" :dismiss-revision="composerDismissRevision" @send="sendText" @action="handleInputAction" @voice-recording="onVoiceRecording" />
    <PteIMUIImagePreview :visible="previewMessage != null && previewMessage.type === 'image'" :src="previewMessage == null ? '' : mediaURL(previewMessage)" @close="previewMessage = null" @save="saveCurrentImage" />
    <PteIMUIVideoPreview :visible="previewMessage != null && previewMessage.type === 'video'" :src="previewMessage == null ? '' : mediaURL(previewMessage)" :poster="previewMessage == null ? '' : videoPoster(previewMessage)" :dark="isDark" @close="previewMessage = null" />
  </view>
</template>

<script lang="uts">
import { PteIMIncomingMessage, PteIMLocation, PteIMSDKClient } from '../../../pte-im-sdk/utssdk/interface.uts'
import { PteIMUIAction, PteIMUICustomAction, PteIMUIEmoji, PteIMUIInputAction, PteIMUIChatController, PteIMUIKit, PteIMUIMapNavigationHandler, PteIMUIReaction, PteIMUIReactionProvider, PteIMUIReadReceiptProvider, PteIMUITheme, PteIMUIThemePalette } from '../../utssdk/PteIMUIKitFacade.uts'
import PteIMUIInputBar from '../PteIMUIInputBar/PteIMUIInputBar.uvue'
import PteIMUIImagePreview from '../PteIMUIImagePreview/PteIMUIImagePreview.uvue'
import PteIMUIVideoPreview from '../PteIMUIVideoPreview/PteIMUIVideoPreview.uvue'
import { PteIMUIMediaPlayback } from '../../utssdk/PteIMUIMediaPlayback.uts'

export default {
  components: { PteIMUIInputBar, PteIMUIImagePreview, PteIMUIVideoPreview },
  props: {
    client: { type: Object, required: true }, conversationId: { type: String, required: true }, title: { type: String, default: '' }, subtitle: { type: String, default: '' }, theme: { type: Object, default: null }, reactionProvider: { type: Object, default: null }, readReceiptProvider: { type: Object, default: null },
    emojis: { type: Array, default: () => [] as PteIMUIEmoji[] }, customActions: { type: Array, default: () => [] as PteIMUICustomAction[] }, rightInset: { type: Number, default: 20 }, mediaResolver: { type: Function, default: null }, mapNavigationHandler: { type: Object, default: null }, avatarUrls: { type: Object, default: null }, headerAvatar: { type: String, default: '' },
  },
  emits: ['action', 'back', 'more', 'voice-call', 'video-call', 'voice-recording', 'message-action', 'business-action', 'location-navigation', 'error'],
  data() { return { messages: [] as PteIMIncomingMessage[], draft: '', language: 'zh-CN', currentUserId: '', themeClass: '', themeStyle: {} as any, latestMessageId: '', isDark: false, controller: null as PteIMUIChatController | null, quotedMessage: null as PteIMIncomingMessage | null, selectedMessageId: '', localReactionStates: {} as any, quickReactions: ['👍', '❤️', '😂', '😮', '😭', '🙏'], previewMessage: null as PteIMIncomingMessage | null, recorder: null as any, recordingCancelled: false, recordingRequested: false, recordingStopTimer: null as any, composerDismissRevision: 0, historyLoading: false, headerAvatarId: '' } },
  mounted() {
    const client = this.client as PteIMSDKClient
    this.currentUserId = client.currentUserId(); this.headerAvatarId = this.headerAvatar.length > 0 ? '__header__' : ''
    client.syncNow()
    const controller = PteIMUIKit.createChatController(client, this.conversationId)
    controller.onChanged = () => { this.messages = controller.messages; if (!this.historyLoading) this.latestMessageId = this.messages.length > 0 ? this.messages[this.messages.length - 1].clientMsgId : ''; const appearance = client.currentAppearance(); this.language = appearance.language === 'en-US' ? 'en-US' : 'zh-CN'; this.applyTheme(); this.acknowledgeConversationRead() }
    this.controller = controller; controller.refresh(); this.applyTheme()
  },
  beforeUnmount() { this.stopRecording(true); this.controller?.dispose(); this.controller = null },
  methods: {
    sendText(value: string) { this.controller?.sendText(value) },
    content(message: PteIMIncomingMessage): any { return message.content as any },
    isOutgoing(message: PteIMIncomingMessage): boolean { return message.senderId === this.currentUserId },
    avatar(message: PteIMIncomingMessage): string { return message.senderId === this.currentUserId ? '我' : 'A' },
    avatarURLForId(identifier: string): string { if (identifier === '__header__') return this.headerAvatar; const values = this.avatarUrls as any; return values == null ? '' : String(values[identifier] ?? '') },
    dismissTransientUI() { if (this.selectedMessageId.length > 0) this.selectedMessageId = ''; this.composerDismissRevision += 1; uni.hideKeyboard() },
    loadOlderMessages() { this.historyLoading = true; this.latestMessageId = ''; (this.client as PteIMSDKClient).syncNow(); this.controller?.loadOlder(); this.historyLoading = false },
    acknowledgeConversationRead() { const conversation = Number(this.conversationId); if (conversation <= 0 || this.messages.length === 0) return; let sequence = 0; this.messages.forEach((message: PteIMIncomingMessage): void => { sequence = Math.max(sequence, Number(message.serverSeq ?? 0)) }); if (sequence > 0) (this.client as PteIMSDKClient).markConversationRead(conversation, sequence, (_error: string | null): void => {}) },
    mediaURL(message: PteIMIncomingMessage): string { const raw = String(this.content(message).url ?? ''); const resolver = this.mediaResolver as any; return resolver == null ? raw : String(resolver(raw, message)) },
    videoPoster(message: PteIMIncomingMessage): string { const value = this.content(message); return String(value.coverUrl ?? value.thumbnailUrl ?? '') },
    videoDuration(message: PteIMIncomingMessage): string { const seconds = Math.max(0, Math.ceil(Number(this.content(message).durationMs ?? 0) / 1000)); return String(Math.floor(seconds / 60)).padStart(2, '0') + ':' + String(seconds % 60).padStart(2, '0') },
    voiceDuration(message: PteIMIncomingMessage): string { const seconds = Math.max(1, Math.ceil(Number(this.content(message).durationMs ?? 0) / 1000)); return this.language === 'en-US' ? seconds.toString() + 's' : seconds.toString() + '秒' },
    fileSize(message: PteIMIncomingMessage): string { const value = Number(this.content(message).sizeBytes ?? 0); if (value <= 0) return ''; return value >= 1048576 ? (value / 1048576).toFixed(1) + ' MB' : Math.ceil(value / 1024).toString() + ' KB' },
    messageText(message: PteIMIncomingMessage): string { const value = this.content(message); return message.type === 'emoji' ? String(value.emojiId ?? '') : String(value.text ?? '') },
    businessTitle(message: PteIMIncomingMessage): string { const type = message.type === 'red_packet' ? copyText(this.language, 'redPacket') : message.type === 'gift' ? copyText(this.language, 'gift') : message.type === 'order' ? copyText(this.language, 'order') : copyText(this.language, 'business'); return type + (String(this.content(message).title ?? '').length > 0 ? ' · ' + String(this.content(message).title) : '') },
    richType(message: PteIMIncomingMessage): string { return ['image', 'video', 'location', 'gift', 'red_packet', 'order', 'file', 'voice'].indexOf(message.type) >= 0 ? 'pte-im-ui-rich-' + message.type : '' },
    timestamp(message: PteIMIncomingMessage): string { const value = new Date(message.createdAt); return String(value.getHours()).padStart(2, '0') + ':' + String(value.getMinutes()).padStart(2, '0') },
    deliveryState(message: PteIMIncomingMessage): string { return this.controller?.stateFor(message.clientMsgId) ?? 'sent' },
    deliveryCopy(message: PteIMIncomingMessage): string { const state = this.deliveryState(message); return state === 'uploading' ? copyText(this.language, 'uploading') : state === 'pending' ? copyText(this.language, 'sending') : state === 'failed' ? copyText(this.language, 'failed') : '✓✓' },
    isRead(message: PteIMIncomingMessage): boolean { const provider = this.readReceiptProvider as PteIMUIReadReceiptProvider | null; return provider != null && provider.isRead(message) },
    reactions(message: PteIMIncomingMessage): PteIMUIReaction[] { const provider = this.reactionProvider as PteIMUIReactionProvider | null; const values = provider == null ? [] : provider.reactionsFor(message).filter((reaction: PteIMUIReaction) => reaction.emoji.length > 0 && reaction.count > 0); const result = [] as PteIMUIReaction[]; const seen = [] as string[]; values.forEach((reaction: PteIMUIReaction) => { const selected = this.reactionSelected(message, reaction.emoji); const persisted = provider != null && provider.reactedByMe(message, reaction.emoji); const delta = selected && !persisted ? 1 : (!selected && persisted ? -1 : 0); result.push({ emoji: reaction.emoji, count: Math.max(0, reaction.count + delta) } as PteIMUIReaction); seen.push(reaction.emoji) }); this.quickReactions.forEach((emoji: string) => { if (seen.indexOf(emoji) < 0 && this.reactionSelected(message, emoji)) result.push({ emoji, count: 1 } as PteIMUIReaction) }); return result.filter((reaction: PteIMUIReaction) => reaction.count > 0) },
    reactionSelected(message: PteIMIncomingMessage, emoji: string): boolean { const key = message.clientMsgId + ':' + emoji; const local = this.localReactionStates[key]; if (local != null) return Boolean(local); const provider = this.reactionProvider as PteIMUIReactionProvider | null; return provider != null && provider.reactedByMe(message, emoji) },
    toggleReaction(message: PteIMIncomingMessage, emoji: string) { const key = message.clientMsgId + ':' + emoji; const selected = !this.reactionSelected(message, emoji); this.localReactionStates[key] = selected; this.$emit('message-action', { action: 'reaction', message, emoji, selected }); },
    requestReaction(message: PteIMIncomingMessage, emoji: string) { this.toggleReaction(message, emoji) },
    showMessageMenu(message: PteIMIncomingMessage) { this.selectedMessageId = this.selectedMessageId === message.clientMsgId ? '' : message.clientMsgId },
    performMessageAction(action: string, message: PteIMIncomingMessage) { this.selectedMessageId = ''; if (action === 'quote') { this.quotedMessage = message; return }; if (action === 'copy') { uni.setClipboardData({ data: this.messageText(message) }); return }; if (action === 'retry') { if (!(this.client as PteIMSDKClient).retryMessage(message.clientMsgId)) this.$emit('error', copyText(this.language, 'retryUnavailable')); return }; if (action === 'delete' || action === 'revoke') { const serverMsgId = String(message.serverMsgId ?? ''); if (serverMsgId.length === 0) { this.$emit('error', copyText(this.language, 'messageNotSynced')); return }; const client = this.client as PteIMSDKClient; const complete = (error: string | null): void => { if (error != null) { this.$emit('error', error); return }; client.syncNow(); this.controller?.refresh() }; if (action === 'delete') client.deleteMessage(serverMsgId, complete); else client.recallMessage(serverMsgId, complete); return }; this.$emit('message-action', { action, message }) },
    previewImage(message: PteIMIncomingMessage) { if (this.mediaURL(message).length > 0) this.previewMessage = message },
    previewVideo(message: PteIMIncomingMessage) { if (this.mediaURL(message).length > 0) this.previewMessage = message },
    saveImage(message: PteIMIncomingMessage) { const url = this.mediaURL(message); if (url.length === 0) return; if (url.indexOf('http://') === 0 || url.indexOf('https://') === 0) { uni.downloadFile({ url, success: (result: any) => this.saveImageFile(String(result.tempFilePath)), fail: (_error: any) => this.$emit('error', copyText(this.language, 'saveImageFailed')) }); return }; this.saveImageFile(url) },
    saveCurrentImage() { if (this.previewMessage != null) this.saveImage(this.previewMessage) },
    saveImageFile(filePath: string) {
      // #ifdef WEB
      const browser: any = globalThis as any
      const link = browser.document?.createElement('a')
      if (link == null) { this.$emit('error', copyText(this.language, 'saveImageFailed')); return }
      link.href = filePath; link.download = 'pte-im-image'; link.style.display = 'none'; browser.document.body.appendChild(link); link.click(); browser.document.body.removeChild(link)
      return
      // #endif
      uni.saveImageToPhotosAlbum({ filePath, fail: (_error: any) => this.$emit('error', copyText(this.language, 'saveImageFailed')) })
    },
    playVoice(message: PteIMIncomingMessage) { PteIMUIMediaPlayback.playVoice('voice:' + message.clientMsgId, this.mediaURL(message)) },
    openLocation(message: PteIMIncomingMessage) { const value = this.content(message); const location = { latitude: Number(value.latitude), longitude: Number(value.longitude), name: String(value.name ?? ''), address: String(value.address ?? '') } as PteIMLocation; const config = (this.client as PteIMSDKClient).mapConfig(); const amapURI = this.amapNavigationURI(location, config == null ? '' : String(config.h5Key ?? '')); const handler = this.mapNavigationHandler as PteIMUIMapNavigationHandler | null; this.$emit('location-navigation', { location, config, amapURI }); if (handler != null && handler.open(location, config, amapURI)) return
      // #ifdef WEB
      const browser: any = globalThis as any
      if (config != null && String(config.h5Key ?? '').length > 0 && browser.open != null) { browser.open(amapURI, '_blank'); return }
      // #endif
      uni.openLocation({ latitude: location.latitude, longitude: location.longitude, name: location.name, address: location.address }) },
    amapNavigationURI(location: PteIMLocation, key: string): string { const parts = ['https://uri.amap.com/marker?position=' + encodeURIComponent(location.longitude.toString() + ',' + location.latitude.toString()), 'name=' + encodeURIComponent(location.name), 'coordinate=gaode', 'callnative=1', 'src=pte-im-uikit']; if (key.length > 0) parts.push('key=' + encodeURIComponent(key)); return parts.join('&') },
    openFile(message: PteIMIncomingMessage) {
      const url = this.mediaURL(message); if (url.length === 0) return
      // #ifdef WEB
      const browser: any = globalThis as any
      if (browser.open == null) { this.$emit('error', copyText(this.language, 'openFileFailed')); return }
      browser.open(url, '_blank')
      return
      // #endif
      uni.downloadFile({ url, success: (result: any) => uni.openDocument({ filePath: result.tempFilePath, showMenu: true }), fail: (_error: any) => this.$emit('error', copyText(this.language, 'openFileFailed')) })
    },
    saveFile(message: PteIMIncomingMessage) {
      const url = this.mediaURL(message); if (url.length === 0) return
      // #ifdef WEB
      const browser: any = globalThis as any
      const link = browser.document?.createElement('a')
      if (link == null) { this.$emit('error', copyText(this.language, 'saveFileFailed')); return }
      link.href = url; link.download = String(this.content(message).fileName ?? 'pte-im-file'); link.style.display = 'none'; browser.document.body.appendChild(link); link.click(); browser.document.body.removeChild(link)
      return
      // #endif
      uni.downloadFile({ url, success: (result: any) => uni.saveFile({ tempFilePath: result.tempFilePath, fail: (_error: any) => this.$emit('error', copyText(this.language, 'saveFileFailed')) }), fail: (_error: any) => this.$emit('error', copyText(this.language, 'saveFileFailed')) })
    },
    handleInputAction(input: PteIMUIInputAction) { if (typeof input !== 'string') { this.$emit('action', input); return }; if (input === 'image' || input === 'camera' || input === 'video') { this.pickMedia(input); return }; if (input === 'file') { this.pickFile(); return }; if (input === 'location') { this.pickLocation(); return }; this.$emit('action', input as PteIMUIAction) },
    pickMedia(type: string) {
      // #ifdef MP-WEIXIN
      uni.chooseMedia({ count: 1, mediaType: type === 'video' ? ['video'] : ['image'], sourceType: type === 'camera' ? ['camera'] : ['album', 'camera'], success: (result: any) => { const path = String(result.tempFiles[0].tempFilePath); const client = this.client as PteIMSDKClient; const id = type === 'video' ? client.uploadAndSendVideo(this.conversationId, path) : client.uploadAndSendImage(this.conversationId, path); this.controller?.trackOutgoing(id, type === 'video' ? 'video' : 'image', { url: path }) }, fail: (_error: any) => {} })
      // #endif
      // #ifdef WEB
      if (type === 'video') {
        uni.chooseVideo({ sourceType: ['album', 'camera'], success: (result: any) => { const path = String(result.tempFilePath); const id = (this.client as PteIMSDKClient).uploadAndSendVideo(this.conversationId, path); this.controller?.trackOutgoing(id, 'video', { url: path, durationMs: Math.round(Number(result.duration ?? 0) * 1000) }) }, fail: (_error: any) => {} })
      } else {
        uni.chooseImage({ count: 1, sourceType: type === 'camera' ? ['camera'] : ['album', 'camera'], success: (result: any) => { const path = String(result.tempFilePaths[0]); const id = (this.client as PteIMSDKClient).uploadAndSendImage(this.conversationId, path); this.controller?.trackOutgoing(id, 'image', { url: path }) }, fail: (_error: any) => {} })
      }
      // #endif
    },
    pickFile() {
      // #ifdef MP-WEIXIN
      uni.chooseMessageFile({ count: 1, type: 'file', success: (result: any) => { const file = result.tempFiles[0]; const path = String(file.path); const id = (this.client as PteIMSDKClient).uploadAndSendFile(this.conversationId, path); this.controller?.trackOutgoing(id, 'file', { url: path, fileName: String(file.name ?? '') }) } })
      // #endif
      // #ifdef WEB
      uni.chooseFile({ count: 1, type: 'all', success: (result: any) => { const file = result.tempFiles[0]; const path = String(file.path ?? result.tempFilePaths[0]); const name = String(file.name ?? ''); const mimeType = String(file.type ?? ''); const id = (this.client as PteIMSDKClient).uploadAndSendFile(this.conversationId, path, name, mimeType); this.controller?.trackOutgoing(id, 'file', { url: path, fileName: name, sizeBytes: Number(file.size ?? 0), mimeType }) }, fail: (_error: any) => {} })
      // #endif
    },
    pickLocation() {
      // #ifdef MP-WEIXIN
      uni.chooseLocation({ success: (value: any) => { const location = { latitude: Number(value.latitude), longitude: Number(value.longitude), name: String(value.name ?? ''), address: String(value.address ?? '') } as PteIMLocation; const id = (this.client as PteIMSDKClient).sendLocation(this.conversationId, location); this.controller?.trackOutgoing(id, 'location', location) } })
      // #endif
      // #ifdef WEB
      uni.chooseLocation({ success: (value: any) => { const location = { latitude: Number(value.latitude), longitude: Number(value.longitude), name: String(value.name ?? ''), address: String(value.address ?? '') } as PteIMLocation; const id = (this.client as PteIMSDKClient).sendLocation(this.conversationId, location); this.controller?.trackOutgoing(id, 'location', location) }, fail: (_error: any) => {} })
      // #endif
    },
    onVoiceRecording(payload: any) { const active = Boolean(payload.recording); const cancelled = Boolean(payload.cancelled); this.recordingCancelled = cancelled; this.$emit('voice-recording', payload); if (active) { if (!this.recordingRequested) this.startRecording(); return }; this.stopRecording(cancelled); if (Boolean(payload.tooShort)) this.$emit('error', copyText(this.language, 'voiceTooShort')) },
    startRecording() {
      if (this.recordingRequested) return
      this.recordingRequested = true
      // #ifdef MP-WEIXIN
      const manager = uni.getRecorderManager(); this.recorder = manager; this.recordingCancelled = false; manager.onStop((result: any) => { const cancelled = this.recordingCancelled; const duration = Math.min(60000, Math.max(0, Number(result.duration ?? 0))); this.recorder = null; this.recordingRequested = false; if (cancelled || duration < 1000) return; const id = (this.client as PteIMSDKClient).uploadAndSendVoice(this.conversationId, String(result.tempFilePath), duration); this.controller?.trackOutgoing(id, 'voice', { url: String(result.tempFilePath), durationMs: duration }) }); manager.start({ duration: 60000, format: 'mp3' })
      // #endif
      // #ifdef WEB
      const browser: any = globalThis as any
      const media = browser.navigator?.mediaDevices
      if (media == null || media.getUserMedia == null || browser.MediaRecorder == null) { this.$emit('error', copyText(this.language, 'voiceUnsupported')); return }
      const startedAt = Date.now()
      this.recordingCancelled = false
      media.getUserMedia({ audio: true }).then((stream: any) => {
        if (!this.recordingRequested) { stream.getTracks().forEach((track: any) => track.stop()); return }
        const recorder = new browser.MediaRecorder(stream)
        const chunks = [] as any[]
        recorder.ondataavailable = (event: any) => { if (event.data != null && Number(event.data.size ?? 0) > 0) chunks.push(event.data) }
        recorder.onstop = () => {
          stream.getTracks().forEach((track: any) => track.stop())
          this.recorder = null
          this.recordingRequested = false
          if (this.recordingCancelled || chunks.length === 0) return
          const mimeType = String(recorder.mimeType ?? 'audio/webm')
          const blob = new browser.Blob(chunks, { type: mimeType })
          const path = String(browser.URL.createObjectURL(blob))
          const duration = Math.min(60000, Math.max(0, Date.now() - startedAt))
          if (duration < 1000) return
          const id = (this.client as PteIMSDKClient).uploadAndSendVoice(this.conversationId, path, duration, '', 'voice.webm', mimeType)
          this.controller?.trackOutgoing(id, 'voice', { url: path, durationMs: duration })
        }
        this.recorder = recorder
        recorder.start()
        this.recordingStopTimer = setTimeout(() => { if (this.recordingRequested) this.stopRecording(false) }, 60000)
      }).catch((_error: any) => this.$emit('error', copyText(this.language, 'voicePermissionDenied')))
      // #endif
    },
    stopRecording(cancelled: boolean) { this.recordingRequested = false; this.recordingCancelled = cancelled; if (this.recordingStopTimer != null) { clearTimeout(this.recordingStopTimer); this.recordingStopTimer = null }; if (this.recorder != null) { try { this.recorder.stop() } catch (_error) {} }; this.recorder = null },
    applyTheme() { const theme = (this.theme as PteIMUITheme | null) ?? new PteIMUITheme(); const mode = (this.client as PteIMSDKClient).currentAppearance().themeMode; this.isDark = mode === 'dark' || (mode === 'system' && uni.getSystemInfoSync().theme === 'dark'); const palette = this.isDark ? theme.dark : theme.light; this.themeClass = this.isDark ? 'pte-im-ui-dark' : 'pte-im-ui-light'; this.themeStyle = this.cssVariables(palette) },
    cssVariables(palette: PteIMUIThemePalette): any { return { '--pte-im-ui-background': palette.background, '--pte-im-ui-surface': palette.surface, '--pte-im-ui-composer': palette.composer, '--pte-im-ui-incoming': palette.incoming, '--pte-im-ui-outgoing-start': palette.outgoingStart, '--pte-im-ui-outgoing-end': palette.outgoingEnd, '--pte-im-ui-text': palette.text, '--pte-im-ui-muted': palette.muted, '--pte-im-ui-incoming-text': palette.incomingText, '--pte-im-ui-outgoing-text': palette.outgoingText, '--pte-im-ui-icon': palette.icon, '--pte-im-ui-divider': palette.divider, '--pte-im-ui-panel': palette.panel, '--pte-im-ui-panel-item': palette.panelItem, '--pte-im-ui-composer-input': palette.composerInput } },
    copy(key: string): string { return copyText(this.language, key) },
  },
}

function copyText(language: string, key: string): string { const en = language === 'en-US'; if (key === 'voice') return en ? 'Voice message' : '语音消息'; if (key === 'video') return en ? 'Video' : '视频'; if (key === 'location') return en ? 'Location' : '位置'; if (key === 'file') return en ? 'File' : '文件'; if (key === 'quote') return en ? 'Reply' : '引用'; if (key === 'copy') return en ? 'Copy' : '复制'; if (key === 'delete') return en ? 'Delete' : '删除'; if (key === 'revoke') return en ? 'Recall' : '撤回'; if (key === 'recalled') return en ? 'This message was recalled' : '此消息已撤回'; if (key === 'reaction') return en ? 'React' : '添加表情'; if (key === 'retry') return en ? 'Retry' : '重发'; if (key === 'retryUnavailable') return en ? 'This message can no longer be retried' : '这条消息无法重新发送'; if (key === 'messageNotSynced') return en ? 'Wait for the message to finish sending' : '消息尚未发送完成'; if (key === 'uploading') return en ? 'Uploading' : '上传中'; if (key === 'sending') return en ? 'Sending' : '发送中'; if (key === 'failed') return en ? 'Failed' : '发送失败'; if (key === 'saveImageFailed') return en ? 'Unable to save image' : '图片保存失败'; if (key === 'saveFileFailed') return en ? 'Unable to save file' : '文件保存失败'; if (key === 'openFileFailed') return en ? 'Unable to open file' : '文件打开失败'; if (key === 'voiceUnsupported') return en ? 'Voice recording is not supported by this browser' : '当前浏览器不支持录音'; if (key === 'voicePermissionDenied') return en ? 'Microphone permission is required' : '请允许麦克风权限后重试'; if (key === 'voiceTooShort') return en ? 'Voice messages must be at least 1 second' : '语音消息至少需要录制 1 秒'; if (key === 'redPacket') return en ? 'Red Packet' : '红包'; if (key === 'gift') return en ? 'Gift' : '礼物'; if (key === 'order') return en ? 'Order' : '订单'; return en ? 'Business message' : '业务消息' }
</script>

<style>
.pte-im-ui-chat { display: flex; flex-direction: column; height: 100%; background-color: var(--pte-im-ui-background); color: var(--pte-im-ui-text); }.pte-im-ui-navigation { display: flex; flex-direction: row; min-height: 44px; align-items: center; padding: 0 8px; box-sizing: border-box; background-color: var(--pte-im-ui-surface); border-bottom: 1px solid var(--pte-im-ui-divider); }.pte-im-ui-navigation-button { display: flex; width: 44px; height: 44px; align-items: center; justify-content: center; margin: 0; padding: 6px; border: 0; background: transparent; }.pte-im-ui-navigation-button image { width: 24px; height: 24px; }.pte-im-ui-navigation-title-wrap { flex: 1; display: flex; min-width: 0; flex-direction: column; justify-content: center; }.pte-im-ui-title { overflow: hidden; color: var(--pte-im-ui-text); font-size: 16px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.pte-im-ui-subtitle { color: #20B778; font-size: 11px; }.pte-im-ui-navigation-actions { display: flex; flex-direction: row; }.pte-im-ui-messages { flex: 1; min-height: 0; padding: 18px 16px; box-sizing: border-box; }.pte-im-ui-message-row { display: flex; flex-direction: row; width: 100%; margin: 10px 0; align-items: flex-start; }.pte-im-ui-outgoing-row { flex-direction: row-reverse; }.pte-im-ui-avatar { display: flex; width: 28px; min-width: 28px; height: 28px; align-items: center; justify-content: center; border-radius: 14px; color: #FFFFFF; background-color: #8757F6; font-size: 12px; font-weight: 600; }.pte-im-ui-message-stack { display: flex; max-width: calc(100% - 42px); flex-direction: column; }.pte-im-ui-stack-incoming { margin-left: 8px; align-items: flex-start; }.pte-im-ui-stack-outgoing { margin-right: 8px; align-items: flex-end; }.pte-im-ui-message-actions { display: flex; flex-direction: row; gap: 4px; max-width: 100%; margin-bottom: 4px; padding: 4px; border-radius: 10px; background-color: var(--pte-im-ui-surface); box-shadow: 0 4px 14px rgba(11, 16, 40, .16); }.pte-im-ui-message-actions button { display: flex; min-width: 28px; height: 28px; align-items: center; justify-content: center; margin: 0; padding: 0 5px; border: 0; border-radius: 8px; background: transparent; color: var(--pte-im-ui-text); font-size: 16px; }.pte-im-ui-message-actions button.is-selected { background-color: var(--pte-im-ui-panel); }.pte-im-ui-message-tools button { gap: 3px; padding: 0 6px; font-size: 10px; }.pte-im-ui-message-tools image { width: 15px; height: 15px; }.pte-im-ui-message { max-width: 100%; padding: 12px 14px; border-radius: 14px; box-sizing: border-box; color: var(--pte-im-ui-incoming-text); font-size: 14px; line-height: 21px; }.pte-im-ui-inline-quote { max-width: 220px; margin-bottom: 6px; padding-bottom: 5px; border-bottom: 1px solid var(--pte-im-ui-divider); color: var(--pte-im-ui-muted); font-size: 11px; line-height: 15px; }.pte-im-ui-recalled { color: var(--pte-im-ui-muted); font-style: italic; }.pte-im-ui-message-text { white-space: pre-wrap; word-break: break-all; }.pte-im-ui-incoming { background-color: var(--pte-im-ui-incoming); }.pte-im-ui-outgoing { color: var(--pte-im-ui-outgoing-text); background-image: linear-gradient(100deg, var(--pte-im-ui-outgoing-start), var(--pte-im-ui-outgoing-end)); }.pte-im-ui-media-image { display: block; width: 206px; height: 154px; border-radius: 8px; }.pte-im-ui-rich-image { padding: 0; overflow: hidden; }.pte-im-ui-rich-video, .pte-im-ui-rich-file, .pte-im-ui-rich-location, .pte-im-ui-rich-voice, .pte-im-ui-business-card { min-width: 186px; }.pte-im-ui-video-cover { width: 218px; height: 142px; border-radius: 8px; }.pte-im-ui-video-card, .pte-im-ui-location-card, .pte-im-ui-file-card, .pte-im-ui-voice-card, .pte-im-ui-business-card { display: flex; flex-direction: column; }.pte-im-ui-card-title { font-weight: 600; }.pte-im-ui-location-card, .pte-im-ui-file-card, .pte-im-ui-business-card { gap: 5px; }.pte-im-ui-reactions { display: flex; flex-direction: row; flex-wrap: wrap; gap: 4px; margin-top: 5px; }.pte-im-ui-reaction { min-height: 24px; padding: 2px 8px; border: 1px solid var(--pte-im-ui-divider); border-radius: 12px; color: var(--pte-im-ui-text); background-color: var(--pte-im-ui-surface); font-size: 11px; }.pte-im-ui-delivery { display: flex; flex-direction: row; gap: 5px; margin-top: 4px; color: var(--pte-im-ui-muted); font-size: 10px; }.pte-im-ui-delivery .is-failed { color: #F25353; }.pte-im-ui-quote-bar { display: flex; flex-direction: row; min-height: 44px; align-items: center; justify-content: space-between; padding: 6px 14px; border-top: 1px solid var(--pte-im-ui-divider); color: var(--pte-im-ui-muted); background-color: var(--pte-im-ui-panel); font-size: 11px; }.pte-im-ui-quote-bar view { display: flex; min-width: 0; flex: 1; flex-direction: column; }.pte-im-ui-quote-name { color: var(--pte-im-ui-outgoing-end); }.pte-im-ui-quote-bar button { display: flex; width: 36px; height: 36px; align-items: center; justify-content: center; margin: 0; border: 0; background: transparent; }.pte-im-ui-quote-bar button image { width: 22px; height: 22px; }
.pte-im-ui-retry { min-height: 20px; margin: -4px 0; padding: 0 4px; border: 0; color: #F25353; background: transparent; font-size: 10px; }.pte-im-ui-read-icon { width:12px; height:12px; }
.pte-im-ui-chat button { border:0; outline:0; box-shadow:none; -webkit-appearance:none; appearance:none; }.pte-im-ui-chat button::after { border: 0; }
.pte-im-ui-chat { background-color: #F4F4FF; }
.pte-im-ui-navigation { min-height: 44px; padding: 0 10px; }
.pte-im-ui-navigation-button { width: 44px; min-width: 44px; height: 44px; padding: 0; }
.pte-im-ui-navigation-button image { width: 44px; height: 44px; }
.pte-im-ui-navigation-avatar { display: flex; width: 34px; height: 34px; align-items: center; justify-content: center; margin: 0 9px 0 4px; border-radius: 17px; color: #FFFFFF; background: linear-gradient(90deg, var(--pte-im-ui-outgoing-start), var(--pte-im-ui-outgoing-end)); font-size: 21px; font-weight: 500; }
.pte-im-ui-navigation-avatar image { width:34px; height:34px; border-radius:17px; }
.pte-im-ui-navigation-title-wrap { min-height: 44px; }
.pte-im-ui-title { font-size: 15px; font-weight: 700; }
.pte-im-ui-subtitle { margin-top: 1px; font-size: 10px; }
.pte-im-ui-navigation-actions .pte-im-ui-navigation-button { width: 44px; min-width: 44px; }
.pte-im-ui-messages { padding: 16px 12px; }
.pte-im-ui-day-divider { display: flex; flex-direction: row; align-items: center; margin: 5px 8px 14px; color: #858DA7; font-size: 10px; }
.pte-im-ui-day-divider view { flex: 1; height: 1px; background-color: #DADDF6; }
.pte-im-ui-day-divider text { margin: 0 14px; }
.pte-im-ui-message-row { margin: 8px 0; }
.pte-im-ui-avatar { background-color: #8757F6; }
.pte-im-ui-avatar image { width:28px; height:28px; border-radius:14px; }
.pte-im-ui-message { padding: 11px 14px; border-radius: 15px; }
.pte-im-ui-incoming { background-color: #FFFFFF; }
.pte-im-ui-rich-location { padding: 0; overflow: hidden; background-color: #FFFFFF; }
.pte-im-ui-location-card { min-width: 238px; padding: 13px 14px; }
.pte-im-ui-red-packet-card { position: relative; display: flex; width: 208px; height: 181px; overflow: hidden; align-items: center; justify-content: center; border-radius: 14px; color: #FFEC31; }
.pte-im-ui-red-packet-card > image { position: absolute; width: 100%; height: 100%; }
.pte-im-ui-red-packet-card > view { z-index: 1; display: flex; width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: flex-end; padding-bottom: 13px; box-sizing: border-box; }
.pte-im-ui-red-packet-card > view text:first-child { margin-bottom: 4px; color: #FFE223; font-size: 14px; font-weight: 700; }
.pte-im-ui-red-packet-card > view text:nth-child(2) { margin-bottom: 12px; color: #FFFFFF; font-size: 11px; }
.pte-im-ui-red-packet-card > view text:last-child { color: #FFE923; font-size: 11px; font-weight: 700; }
.pte-im-ui-photo-card { width: 164px; height: 136px; overflow: hidden; border-radius: 16px; }
.pte-im-ui-photo-card .pte-im-ui-media-image { width: 164px; height: 136px; border-radius: 0; }
.pte-im-ui-photo-placeholder, .pte-im-ui-video-placeholder { display: flex; width: 100%; height: 100%; flex-direction: column; align-items: center; justify-content: center; }
.pte-im-ui-photo-placeholder image { width: 29px; height: 29px; margin-bottom: 5px; }
.pte-im-ui-photo-placeholder text { color: #FFFFFF; font-size: 11px; }
.pte-im-ui-video-card { position: relative; width: 188px; height: 122px; overflow: hidden; border-radius: 16px; }
.pte-im-ui-video-cover { position: absolute; width: 188px; height: 122px; border-radius: 0; }
.pte-im-ui-video-placeholder { position: absolute; }
.pte-im-ui-video-play { position: absolute; display: flex; width: 40px; height: 40px; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.2); border-radius: 23px; background-color: rgba(255,255,255,.1); }
.pte-im-ui-video-play image { width: 20px; height: 20px; }
.pte-im-ui-video-duration { position: absolute; right: 8px; bottom: 7px; display: flex; height: 16px; align-items: center; padding: 0 5px; border-radius: 8px; background-color: rgba(255,255,255,.1); color: rgba(255,255,255,.8); font-size: 10px; }
.pte-im-ui-video-duration image { width: 12px; height: 12px; margin-right: 4px; margin-left: 10px; }
.pte-im-ui-location-card { min-width: 0; overflow: hidden; padding: 0; border-radius: 16px; background-color: #FFFFFF; }
.pte-im-ui-location-card > image { width: 210px; height: 92px; }
.pte-im-ui-location-card > view { display: flex; width: 210px; flex-direction: column; padding: 10px; box-sizing: border-box; color: var(--pte-im-ui-muted); font-size: 9px; }
.pte-im-ui-location-card > view .pte-im-ui-card-title { margin-bottom: 3px; color: var(--pte-im-ui-text); font-size: 12px; }
.pte-im-ui-order-card { display: flex; width: 190px; flex-direction: column; padding: 11px; border-radius: 15px; background-color: #FFFFFF; color: var(--pte-im-ui-text); }
.pte-im-ui-order-main { display: flex; flex-direction: row; align-items: center; }
.pte-im-ui-order-icon { display: flex; width: 54px; height: 54px; align-items: center; justify-content: center; margin-right: 9px; border-radius: 12px; background-color: #E7EDF5; }
.pte-im-ui-order-icon image { width: 30px; height: 30px; }
.pte-im-ui-order-main > view:last-child { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.pte-im-ui-order-main .pte-im-ui-card-title { font-size: 12px; line-height: 17px; }
.pte-im-ui-order-price { margin-top: 2px; color: #EE3B46; font-size: 13px; font-weight: 700; }
.pte-im-ui-order-footer { display: flex; flex-direction: row; justify-content: space-between; margin-top: 7px; padding-top: 7px; border-top: 1px solid var(--pte-im-ui-divider); color: var(--pte-im-ui-muted); font-size: 10px; }
.pte-im-ui-order-footer text:last-child { color: var(--pte-im-ui-outgoing-end); }
.pte-im-ui-dark.pte-im-ui-chat { background-color: var(--pte-im-ui-background); }
.pte-im-ui-dark .pte-im-ui-day-divider view { background-color: var(--pte-im-ui-divider); }
.pte-im-ui-dark .pte-im-ui-incoming { background-color: var(--pte-im-ui-incoming); }
.pte-im-ui-dark .pte-im-ui-rich-location { background-color: var(--pte-im-ui-surface); }
.pte-im-ui-dark .pte-im-ui-location-card, .pte-im-ui-dark .pte-im-ui-order-card { background-color: var(--pte-im-ui-surface); }
.pte-im-ui-dark .pte-im-ui-order-icon { background-color: #28344A; }
.pte-im-ui-dark .pte-im-ui-rich-voice { padding: 0; background-color: transparent; }
.pte-im-ui-messages { padding-right: 4px; }
.pte-im-ui-stack-incoming { margin-left: 8px; }.pte-im-ui-stack-outgoing { margin-right: 8px; }
.pte-im-ui-rich-image, .pte-im-ui-rich-video, .pte-im-ui-rich-file, .pte-im-ui-rich-voice { min-width: 0; padding: 0; overflow: hidden; background-color: transparent; }
.pte-im-ui-video-card, .pte-im-ui-photo-card { flex-shrink: 0; }
.pte-im-ui-file-card { display: flex; width: 210px; min-height: 66px; flex-direction: column; justify-content: center; gap: 5px; padding: 12px 14px; overflow: hidden; border-radius: 15px; box-sizing: border-box; color: var(--pte-im-ui-text); background-color: var(--pte-im-ui-surface); }
.pte-im-ui-file-card .pte-im-ui-card-title { overflow: hidden; font-size: 14px; line-height: 20px; text-overflow: ellipsis; white-space: nowrap; }.pte-im-ui-file-card text:last-child { color: var(--pte-im-ui-muted); font-size: 12px; line-height: 16px; }
