<template>
  <view :class="['pte-im-ui-contact-list', { 'is-dark': isDark }]" :style="themeStyle">
    <view class="pte-im-ui-contact-nav" :style="{ paddingRight: rightInset + 'px' }"><view class="pte-im-ui-contact-brand"><image class="pte-im-ui-contact-logo" src="../../static/list/PteIMUILogo.png" mode="aspectFit" /><text class="pte-im-ui-contact-page-title">{{ language === 'en-US' ? 'Contacts' : '联系人' }}</text></view><button class="pte-im-ui-contact-create" @click="$emit('add-group')"><image v-if="isDark" src="../../static/list/PteIMUIContactCreateDark.png" mode="aspectFit" /><image v-else src="../../static/list/PteIMUIContactCreateLight.png" mode="aspectFit" /></button></view>
    <view class="pte-im-ui-contact-quick"><button @click="$emit('add')"><image src="../../static/list/PteIMUIContactAddFriend.png" mode="aspectFit" /><text>{{ language === 'en-US' ? 'Add Friend' : '添加好友' }}</text></button><button @click="$emit('add-group')"><image src="../../static/list/PteIMUIContactNewGroup.png" mode="aspectFit" /><text>{{ language === 'en-US' ? 'New Group' : '发起群聊' }}</text></button></view>
    <scroll-view class="pte-im-ui-contact-scroll" scroll-y="true" :refresher-enabled="true" :refresher-triggered="refreshing" :refresher-default-style="isDark ? 'white' : 'black'" refresher-background="transparent" @refresherrefresh="refreshList" @scrolltolower="loadMore">
    <text class="pte-im-ui-contact-section pte-im-ui-contact-personal-section">{{ mode === 'groups' ? (language === 'en-US' ? 'GROUPS' : '群组') : (language === 'en-US' ? 'PERSONAL' : '个人') }}</text>
    <view v-for="item in contacts" :key="itemKey(item)" class="pte-im-ui-contact-row">
      <view class="pte-im-ui-contact-avatar" :style="{ backgroundColor: avatarColor(item.identifier) }" @click="avatar(item)"><image v-if="String(item.avatar ?? '').length > 0" :src="String(item.avatar)" mode="aspectFill" /><text v-else>{{ item.isGroup ? '#' : item.avatarText }}</text><view v-if="isOnline(item)" class="pte-im-ui-contact-online"></view></view>
      <view class="pte-im-ui-contact-copy" @click="select(item)"><text class="pte-im-ui-contact-title">{{ item.title }}</text><text v-if="item.subtitle" class="pte-im-ui-contact-subtitle">{{ item.subtitle }}</text></view><image v-if="isDark" class="pte-im-ui-contact-arrow" src="../../static/list/PteIMUIContactArrowDark.png" mode="aspectFit" /><image v-else class="pte-im-ui-contact-arrow" src="../../static/list/PteIMUIContactArrowLight.png" mode="aspectFit" />
    </view>
    <view v-if="includeGroups && mode === 'friends' && groups.length > 0"><text class="pte-im-ui-contact-section pte-im-ui-contact-group-section">{{ language === 'en-US' ? 'GROUPS' : '群组' }}</text><view v-for="item in groups" :key="groupItemKey(item)" class="pte-im-ui-contact-row"><view class="pte-im-ui-contact-avatar" :style="{ backgroundColor: avatarColor(item.identifier) }" @click="avatar(item)"><image v-if="String(item.avatar ?? '').length > 0" :src="String(item.avatar)" mode="aspectFill" /><text v-else>#</text></view><view class="pte-im-ui-contact-copy" @click="selectGroup(item)"><text class="pte-im-ui-contact-title">{{ item.title }}</text><text v-if="item.subtitle" class="pte-im-ui-contact-subtitle">{{ item.subtitle }}</text></view><image v-if="isDark" class="pte-im-ui-contact-arrow" src="../../static/list/PteIMUIContactArrowDark.png" mode="aspectFit" /><image v-else class="pte-im-ui-contact-arrow" src="../../static/list/PteIMUIContactArrowLight.png" mode="aspectFit" /></view></view><view v-if="contactsLoading || groupsLoading" class="pte-im-ui-contact-load-state"><text>{{ language === 'en-US' ? 'Loading more…' : '正在加载更多…' }}</text></view><view v-else-if="contactsHasMore || groupsHasMore" class="pte-im-ui-contact-load-state"><text>{{ language === 'en-US' ? 'Pull up to load more' : '上拉加载更多' }}</text></view><view v-else-if="contacts.length > 0 || groups.length > 0" class="pte-im-ui-contact-load-state"><text>{{ language === 'en-US' ? 'No more contacts' : '没有更多联系人了' }}</text></view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
import { PteIMSDKClient } from '../../../pte-im-sdk/utssdk/interface.uts'
import { PteIMUIContactListController, PteIMUIContactListMode, PteIMUIContactPresentation, PteIMUIKit, PteIMUITheme } from '../../utssdk/PteIMUIKitFacade.uts'

/**
 * Drop-in friend/follow/group list. It exposes select/error events so the
 * host controls navigation and error presentation in every UTS runtime.
 */
export default {
  props: { client: { type: Object, required: true }, mode: { type: String, default: 'friends' }, includeGroups: { type: Boolean, default: false }, theme: { type: Object, default: null }, dark: { type: Boolean, default: false }, english: { type: Boolean, default: true }, rightInset: { type: Number, default: 20 }, syncRevision: { type: Number, default: 0 } },
  emits: ['select', 'avatar', 'error', 'add', 'add-group'],
  data() { return { contacts: [] as PteIMUIContactPresentation[], groups: [] as PteIMUIContactPresentation[], language: 'zh-CN', isDark: false, themeStyle: {} as any, controller: null as PteIMUIContactListController | null, groupController: null as PteIMUIContactListController | null, refreshing: false, contactsLoading: false, contactsHasMore: false, groupsLoading: false, groupsHasMore: false } },
  watch: { dark() { this.applyTheme() }, english() { this.applyTheme() }, syncRevision() { this.refreshList() } },
  mounted() {
    const controller = PteIMUIKit.createContactListController(this.client as PteIMSDKClient, this.mode as PteIMUIContactListMode)
    controller.onChanged = () => { this.contacts = controller.contacts; this.contactsLoading = controller.loading; this.contactsHasMore = controller.hasMore; this.applyTheme() }
    controller.onError = (message: string) => this.$emit('error', message)
    controller.onConversationSelected = (conversationId: string, title: string, avatar: string) => this.$emit('select', { conversationId, title, avatar })
    this.controller = controller; controller.refresh(); this.applyTheme()
    if (this.includeGroups && this.mode === 'friends') { const groupController = PteIMUIKit.createContactListController(this.client as PteIMSDKClient, 'groups'); groupController.onChanged = () => { this.groups = groupController.contacts; this.groupsLoading = groupController.loading; this.groupsHasMore = groupController.hasMore; this.applyTheme() }; groupController.onError = (message: string) => this.$emit('error', message); groupController.onConversationSelected = (conversationId: string, title: string, avatar: string) => this.$emit('select', { conversationId, title, avatar }); this.groupController = groupController; groupController.refresh() }
  },
  beforeUnmount() { this.controller?.dispose(); this.groupController?.dispose(); this.controller = null; this.groupController = null },
  methods: {
    refreshList() { if (this.refreshing) return; this.refreshing = true; const client = this.client as PteIMSDKClient; client.syncNow(); client.syncConversationsNow(); if (this.controller != null) { this.controller.refresh(); this.contactsLoading = this.controller.loading; this.contactsHasMore = this.controller.hasMore }; if (this.groupController != null) { this.groupController.refresh(); this.groupsLoading = this.groupController.loading; this.groupsHasMore = this.groupController.hasMore }; setTimeout(() => { this.refreshing = false }, 800) },
    loadMore() { if (this.controller != null) { this.controller.loadNextPage(); this.contactsLoading = this.controller.loading; this.contactsHasMore = this.controller.hasMore }; if (this.groupController != null) { this.groupController.loadNextPage(); this.groupsLoading = this.groupController.loading; this.groupsHasMore = this.groupController.hasMore } },
    select(item: PteIMUIContactPresentation) { this.controller?.select(item) },
    selectGroup(item: PteIMUIContactPresentation) { this.groupController?.select(item) },
    avatar(item: PteIMUIContactPresentation) { this.$emit('avatar', item) },
    itemKey(item: PteIMUIContactPresentation): string { return (item.isGroup ? 'g:' : 'u:') + item.identifier },
    groupItemKey(item: PteIMUIContactPresentation): string { return 'g:' + item.identifier },
    avatarColor(identifier: string): string { const colors = ['#8757F6', '#0798BA', '#009A6F', '#E78000', '#D82571', '#7639E8']; return colors[identifier.length % colors.length] },
    isOnline(item: PteIMUIContactPresentation): boolean { return Boolean((item as any).online) },
    applyTheme() { const client = this.client as PteIMSDKClient; const appearance = client.currentAppearance(); this.language = Boolean(this.english) ? 'en-US' : 'zh-CN'; const theme = (this.theme as PteIMUITheme | null) ?? new PteIMUITheme(); this.isDark = Boolean(this.dark); this.themeStyle = PteIMUITheme.cssVariables(PteIMUITheme.resolve(client, theme, this.isDark)) },
  },
}
</script>

<style>
.pte-im-ui-contact-list { display:flex; height:100%; flex-direction:column; background-color:var(--pte-im-ui-background,#F1F1FF); }.pte-im-ui-contact-nav { display:flex; flex-direction:row; min-height:44px; align-items:center; justify-content:space-between; padding:0 20px; background-color:var(--pte-im-ui-surface,#FFF); }.pte-im-ui-contact-brand { display:flex; flex-direction:row; align-items:center; }.pte-im-ui-contact-logo { width:28px; height:28px; }.pte-im-ui-contact-page-title { margin-left:8px; color:var(--pte-im-ui-text); font-size:18px; font-weight:700; }.pte-im-ui-contact-create { display:flex; width:44px; height:44px; align-items:center; justify-content:center; margin:0; padding:0; border:0; background:transparent; }.pte-im-ui-contact-create image { width:44px; height:44px; }.pte-im-ui-contact-quick { display:flex; flex-direction:row; gap:12px; padding:14px 20px; color:var(--pte-im-ui-text); background-color:var(--pte-im-ui-background,#F1F1FF); font-size:14px; }.pte-im-ui-contact-quick button { display:flex; flex-direction:row; flex:1; height:48px; align-items:center; justify-content:flex-start; margin:0; padding:0 12px; border:0; border-radius:14px; color:var(--pte-im-ui-text); background-color:var(--pte-im-ui-panel); font-size:14px; font-weight:500; }.pte-im-ui-contact-quick image { width:28px; height:28px; margin-right:10px; }.pte-im-ui-contact-scroll { flex:1; min-height:0; }.pte-im-ui-contact-load-state { display:flex; height:32px; align-items:center; justify-content:center; margin:6px 20px; border-radius:10px; color:#6D56B3; background:#E9E5FF; font-size:11px; }.pte-im-ui-contact-load-state { margin-top:12px; margin-bottom:20px; }.is-dark .pte-im-ui-contact-load-state { color:#D5CBFF; background:#24204D; }.pte-im-ui-contact-section { display:block; height:32px; padding:12px 20px 0; color:var(--pte-im-ui-muted); font-size:10px; font-weight:600; letter-spacing:1.1px; box-sizing:border-box; }
.pte-im-ui-contact-row { display:flex; flex-direction:row; align-items:center; height:63px; padding:0 18px 0 20px; border-bottom:1px solid var(--pte-im-ui-divider,#E8E7F6); background-color:var(--pte-im-ui-background,#F1F1FF); box-sizing:border-box; }.pte-im-ui-contact-avatar { position:relative; display:flex; align-items:center; justify-content:center; width:40px; height:40px; margin-right:12px; border-radius:20px; color:#FFF; font-size:15px; }.pte-im-ui-contact-online { position:absolute; right:0; bottom:0; width:9px; height:9px; border:1px solid var(--pte-im-ui-background,#F1F1FF); border-radius:7px; box-sizing:border-box; background-color:#12C96B; }.pte-im-ui-contact-copy { display:flex; flex:1; flex-direction:column; min-width:0; }.pte-im-ui-contact-title { overflow:hidden; color:var(--pte-im-ui-text,#25233F); font-size:14px; font-weight:500; text-overflow:ellipsis; white-space:nowrap; }.pte-im-ui-contact-subtitle { margin-top:3px; overflow:hidden; color:var(--pte-im-ui-muted,#76758F); font-size:10px; text-overflow:ellipsis; white-space:nowrap; }.pte-im-ui-contact-arrow { width:18px; height:18px; }
.pte-im-ui-contact-avatar image { width:40px; height:40px; border-radius:20px; }
.pte-im-ui-contact-list button { border:0; outline:0; box-shadow:none; -webkit-appearance:none; appearance:none; }.pte-im-ui-contact-list button::after { border: 0; }.pte-im-ui-contact-quick button { background-color:#F1F1FF; }.is-dark .pte-im-ui-contact-quick button { background-color:#211E4C; }
</style>
