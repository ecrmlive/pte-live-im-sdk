<template>
  <view class="pte-im-ui-contact-list" :style="themeStyle">
    <view class="pte-im-ui-contact-nav"><view class="pte-im-ui-contact-brand"><image class="pte-im-ui-contact-logo" src="/uni_modules/pte-im-uikit/static/shell/logo.png" mode="aspectFit" /><text class="pte-im-ui-contact-page-title">{{ language === 'en-US' ? 'Contacts' : '联系人' }}</text></view><view class="pte-im-ui-contact-nav-actions"><button @click="toggleAppearance"><image :src="isDark ? '/uni_modules/pte-im-uikit/static/shell/theme-dark.png' : '/uni_modules/pte-im-uikit/static/shell/theme-light.png'" mode="aspectFit" /></button><button @click="toggleLanguage"><image :src="isDark ? '/uni_modules/pte-im-uikit/static/shell/language-dark.png' : '/uni_modules/pte-im-uikit/static/shell/language-light.png'" mode="aspectFit" /></button><button @click="$emit('add')"><image :src="isDark ? '/uni_modules/pte-im-uikit/static/shell/add-dark.png' : '/uni_modules/pte-im-uikit/static/shell/add-light.png'" mode="aspectFit" /></button></view></view>
    <view class="pte-im-ui-contact-quick"><button @click="$emit('add')"><image src="/uni_modules/pte-im-uikit/static/shell/contact-add.png" mode="aspectFit" /><text>{{ language === 'en-US' ? 'Add Friend' : '添加好友' }}</text></button><button @click="$emit('add-group')"><image src="/uni_modules/pte-im-uikit/static/shell/contact-group.png" mode="aspectFit" /><text>{{ language === 'en-US' ? 'New Group' : '发起群聊' }}</text></button></view>
    <scroll-view class="pte-im-ui-contact-scroll" scroll-y="true" @scrolltolower="loadMore">
    <text class="pte-im-ui-contact-section">{{ mode === 'groups' ? (language === 'en-US' ? 'GROUPS' : '群组') : (language === 'en-US' ? 'PERSONAL' : '联系人') }}</text>
    <view v-for="item in contacts" :key="itemKey(item)" class="pte-im-ui-contact-row">
      <view class="pte-im-ui-contact-avatar" @click="avatar(item)"><text>{{ item.avatarText }}</text></view>
      <view class="pte-im-ui-contact-copy" @click="select(item)"><text class="pte-im-ui-contact-title">{{ item.title }}</text><text v-if="item.subtitle" class="pte-im-ui-contact-subtitle">{{ item.subtitle }}</text></view><image class="pte-im-ui-contact-arrow" src="/uni_modules/pte-im-uikit/static/shell/arrow.png" mode="aspectFit" />
    </view>
    </scroll-view>
  </view>
</template>

<script lang="uts">
import { PteIMSDKClient } from '../../../pte-im-sdk/utssdk/interface.uts'
import { PteIMUIContactListController, PteIMUIContactListMode, PteIMUIContactPresentation, PteIMUIKit, PteIMUITheme } from '../../utssdk/PteIMUIKitFacade.uts'

/**
 * Drop-in friend/follow/group list. It exposes select/error events so the
 * host controls navigation and error presentation in every UTS runtime.
 */
export default {
  props: { client: { type: Object, required: true }, mode: { type: String, default: 'friends' }, theme: { type: Object, default: null } },
  emits: ['select', 'avatar', 'error', 'add', 'add-group'],
  data() { return { contacts: [] as PteIMUIContactPresentation[], language: 'zh-CN', isDark: false, themeStyle: {} as any, controller: null as PteIMUIContactListController | null } },
  mounted() {
    const controller = PteIMUIKit.createContactListController(this.client as PteIMSDKClient, this.mode as PteIMUIContactListMode)
    controller.onChanged = () => { this.contacts = controller.contacts; this.applyTheme() }
    controller.onError = (message: string) => this.$emit('error', message)
    controller.onConversationSelected = (conversationId: string, title: string) => this.$emit('select', { conversationId, title })
    this.controller = controller; controller.refresh(); this.applyTheme()
  },
  beforeUnmount() { this.controller?.dispose(); this.controller = null },
  methods: {
    loadMore() { this.controller?.loadNextPage() },
    select(item: PteIMUIContactPresentation) { this.controller?.select(item) },
    avatar(item: PteIMUIContactPresentation) { this.$emit('avatar', item) },
    itemKey(item: PteIMUIContactPresentation): string { return (item.isGroup ? 'g:' : 'u:') + item.identifier },
    toggleAppearance() { const client = this.client as PteIMSDKClient; const appearance = client.currentAppearance(); client.updateAppearance(appearance.themeMode === 'dark' ? 'light' : 'dark', appearance.language); this.applyTheme() },
    toggleLanguage() { const client = this.client as PteIMSDKClient; const appearance = client.currentAppearance(); client.updateAppearance(appearance.themeMode, appearance.language === 'en-US' ? 'zh-CN' : 'en-US'); this.applyTheme() },
    applyTheme() { const client = this.client as PteIMSDKClient; const appearance = client.currentAppearance(); this.language = appearance.language === 'en-US' ? 'en-US' : 'zh-CN'; const theme = (this.theme as PteIMUITheme | null) ?? new PteIMUITheme(); this.isDark = appearance.themeMode === 'dark' || (appearance.themeMode === 'system' && uni.getSystemInfoSync().theme === 'dark'); this.themeStyle = PteIMUITheme.cssVariables(PteIMUITheme.resolve(client, theme, this.isDark)) },
  },
}
</script>

<style>
.pte-im-ui-contact-list { display: flex; height: 100%; flex-direction: column; background-color: var(--pte-im-ui-background, #F7F9FF); }.pte-im-ui-contact-nav { display: flex; min-height: 44px; align-items: center; justify-content: space-between; padding: 0 16px; border-bottom: 1px solid var(--pte-im-ui-divider); background-color: var(--pte-im-ui-surface); }.pte-im-ui-contact-brand { display: flex; align-items: center; }.pte-im-ui-contact-logo { width: 28px; height: 28px; }.pte-im-ui-contact-page-title { margin-left: 8px; color: var(--pte-im-ui-text); font-size: 18px; font-weight: 700; }.pte-im-ui-contact-nav-actions { display: flex; gap: 6px; }.pte-im-ui-contact-nav-actions button { display: flex; width: 30px; height: 44px; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; }.pte-im-ui-contact-nav-actions image { width: 20px; height: 20px; }.pte-im-ui-contact-quick { display: flex; gap: 12px; padding: 12px 16px; color: var(--pte-im-ui-text); font-size: 14px; }.pte-im-ui-contact-quick button { display: flex; flex: 1; height: 48px; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; border-radius: 12px; color: var(--pte-im-ui-text); background-color: var(--pte-im-ui-panel); font-size: 14px; }.pte-im-ui-contact-quick image { width: 24px; height: 24px; margin-right: 8px; }.pte-im-ui-contact-scroll { flex: 1; min-height: 0; }.pte-im-ui-contact-section { display: block; padding: 10px 16px 4px; color: var(--pte-im-ui-muted); font-size: 11px; font-weight: 600; letter-spacing: 1px; }
.pte-im-ui-contact-row { display: flex; align-items: center; min-height: 62px; padding: 8px 16px; border-bottom: 1px solid var(--pte-im-ui-divider, #DDE2F2); background-color: var(--pte-im-ui-background, #F7F9FF); box-sizing: border-box; }.pte-im-ui-contact-avatar { display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; margin-right: 12px; border-radius: 19px; color: #FFFFFF; background-color: var(--pte-im-ui-outgoing-end, #7D40EF); font-size: 14px; }.pte-im-ui-contact-copy { display: flex; flex: 1; flex-direction: column; min-width: 0; }.pte-im-ui-contact-title { overflow: hidden; color: var(--pte-im-ui-text, #171C2E); font-size: 14px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.pte-im-ui-contact-subtitle { margin-top: 3px; overflow: hidden; color: var(--pte-im-ui-muted, #666D84); font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }.pte-im-ui-contact-arrow { width: 16px; height: 16px; }
</style>
