<template>
  <view v-if="visible" class="pte-im-ui-media-preview" @click="$emit('close')">
    <image class="pte-im-ui-preview-image" :src="src" mode="aspectFit" @longpress="$emit('save')" />
  </view>
</template>

<script lang="uts">
/** A standalone image preview surface. Hosts may wrap this component to add galleries or custom menus. */
export default {
  props: { visible: { type: Boolean, default: false }, src: { type: String, default: '' } },
  emits: ['close', 'save'],
}
</script>

<style>
.pte-im-ui-media-preview { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, .94); }.pte-im-ui-preview-image { width: 100%; height: 100%; }
</style>
