<template>
  <view class="pte-im-ui-navigation-shell">
    <view class="pte-im-ui-navigation-bar" :class="dark ? 'is-dark' : ''">
      <view class="pte-im-ui-navigation-language" @click="menuOpen = !menuOpen"><text>{{ languageTitle() }}</text></view>
      <text class="pte-im-ui-navigation-title">{{ title }}</text>
      <image class="pte-im-ui-navigation-appearance" :src="dark ? '/uni_modules/pte-im-uikit/static/pte-im-ui-navigation-theme-dark.png' : '/uni_modules/pte-im-uikit/static/pte-im-ui-navigation-theme-light.png'" @click="toggleTheme" />
    </view>
    <view v-if="menuOpen" class="pte-im-ui-navigation-menu" :class="dark ? 'is-dark' : ''">
      <text :class="language === 'system' ? 'is-selected' : ''" @click="selectLanguage('system')">跟随系统</text>
      <text :class="language === 'zh-CN' ? 'is-selected' : ''" @click="selectLanguage('zh-CN')">简体中文</text>
      <text :class="language === 'en-US' ? 'is-selected' : ''" @click="selectLanguage('en-US')">English</text>
    </view>
  </view>
</template>

<script lang="uts">
export default {
  props: {
    title: { type: String, default: '' },
    language: { type: String, default: 'en-US' },
    dark: { type: Boolean, default: false }
  },
  emits: ['language-select', 'theme-select'],
  data() { return { menuOpen: false } },
  methods: {
    languageTitle(): string { return this.language === 'zh-CN' ? '简体中文' : this.language === 'system' ? '跟随系统' : 'English' },
    selectLanguage(language: string) { this.menuOpen = false; this.$emit('language-select', language) },
    toggleTheme() { this.$emit('theme-select', this.dark ? 'light' : 'dark') }
  }
}
</script>

<style>
.pte-im-ui-navigation-shell { position: relative; z-index: 20; }
.pte-im-ui-navigation-bar { display: flex; align-items: center; height: 112rpx; padding: 0 28rpx; background-color: #F4F4FF; box-sizing: border-box; }
.pte-im-ui-navigation-bar.is-dark { background-color: #0E111C; }
.pte-im-ui-navigation-language { width: 208rpx; height: 64rpx; color: #656982; font-size: 28rpx; line-height: 64rpx; text-align: center; }
.is-dark .pte-im-ui-navigation-language { color: #CCD3F2; border-radius: 32rpx; background-color: #25224D; }
.pte-im-ui-navigation-title { flex: 1; overflow: hidden; color: #171C2E; font-size: 34rpx; font-weight: 600; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.is-dark .pte-im-ui-navigation-title { color: #EFF2FF; }
.pte-im-ui-navigation-appearance { width: 64rpx; height: 64rpx; margin-left: 18rpx; }
.is-dark .pte-im-ui-navigation-appearance { border-radius: 32rpx; background-color: #222044; }
.pte-im-ui-navigation-menu { position: absolute; top: 100rpx; left: 28rpx; width: 246rpx; padding: 12rpx 0; border-radius: 20rpx; background-color: #FFFFFF; box-shadow: 0 12rpx 28rpx rgba(27, 27, 52, .16); }
.pte-im-ui-navigation-menu.is-dark { background-color: #20263B; box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, .35); }
.pte-im-ui-navigation-menu text { display: block; padding: 22rpx 28rpx; color: #303349; font-size: 27rpx; }
.pte-im-ui-navigation-menu.is-dark text { color: #EFF2FF; }
.pte-im-ui-navigation-menu text.is-selected { margin: 0 10rpx; padding-left: 18rpx; border-radius: 14rpx; background-color: #F2EDFF; }
.pte-im-ui-navigation-menu.is-dark text.is-selected { background-color: #2A2654; }
</style>
