import { PteIMContact, PteIMContactPage, PteIMConversation, PteIMGroupPage, PteIMIncomingMessage, PteIMListener, PteIMLocation, PteIMMapConfig, PteIMRemoteConversation, PteIMSDKClient } from '../../pte-im-sdk/utssdk/interface.uts'

/** Actions that require host application permissions, pickers, or business data. */
/** Built-in actions whose permissions and media selection are completed by UIKit. */
export type PteIMUIAction = 'image' | 'camera' | 'video' | 'voice' | 'location' | 'gift' | 'red_packet' | 'order' | 'file'
/** Shared feedback semantics for all UIKit hosts. */
export type PteIMUINoticeKind = 'success' | 'error' | 'warning'
export type PteIMUINoticePosition = 'bottom' | 'center'
export type PteIMUINoticePayload = { message: string, kind: PteIMUINoticeKind, position: PteIMUINoticePosition, duration: number, revision: number }
/** Host bridge for the reusable notice component. New notices replace the prior one. */
export class PteIMUINoticeHandler {
  private revision: number = 0
  constructor(private callback: (notice: PteIMUINoticePayload) => void = (_notice: PteIMUINoticePayload) => {}) {}
  show(message: string, kind: PteIMUINoticeKind = 'warning', position: PteIMUINoticePosition = 'bottom', duration: number = 2600): void {
    const value = message.trim()
    if (value.length === 0) return
    this.revision += 1
    this.callback({ message: value, kind, position, duration: Math.max(400, duration), revision: this.revision })
  }
  success(message: string, position: PteIMUINoticePosition = 'bottom', duration: number = 2600): void { this.show(message, 'success', position, duration) }
  error(message: string, position: PteIMUINoticePosition = 'bottom', duration: number = 3200): void { this.show(message, 'error', position, duration) }
  warning(message: string, position: PteIMUINoticePosition = 'bottom', duration: number = 3000): void { this.show(message, 'warning', position, duration) }
}
/**
 * An optional host action rendered in the last four slots of the composer.
 * UIKit never invents a business payload for these actions; it reports `id`
 * to the host and keeps the normal composer presentation intact.
 */
export type PteIMUICustomAction = { id: string, title: string, iconUrl: string }
export type PteIMUIInputAction = PteIMUIAction | PteIMUICustomAction
/** Host bridge for AMap navigation. Return true after opening an H5 page or Mini Program AMap SDK. */
export class PteIMUIMapNavigationHandler {
  open(_location: PteIMLocation, _config: PteIMMapConfig | null, _amapURI: string): boolean { return false }
}
/** External emoji packs can use a Unicode value or a 24×32 icon URL. */
export type PteIMUIEmoji = { id: string, value: string, imageUrl?: string, group?: 'common' | 'all' }
export type PteIMUIMessageAction = 'quote' | 'copy' | 'delete' | 'revoke' | 'reaction' | 'retry'
export type PteIMUIContactListMode = 'friends' | 'follows' | 'groups' | 'custom'
export type PteIMUIContactPresentation = { identifier: string, title: string, subtitle: string, avatarText: string, avatar?: string, isGroup: boolean, online?: boolean }

/** Business-owned reaction summary. Core only transports messages, not UI reaction state. */
export type PteIMUIReaction = { emoji: string, count: number }
/** Override this provider from the host repository to render persisted reactions. */
export class PteIMUIReactionProvider {
  reactionsFor(_message: PteIMIncomingMessage): PteIMUIReaction[] { return [] }
  /** Return the persisted current-user vote so UIKit can render the selected reaction. */
  reactedByMe(_message: PteIMIncomingMessage, _emoji: string): boolean { return false }
}

/** Business-owned read receipt source. UIKit renders the supplied state but never fabricates receipt data. */
export class PteIMUIReadReceiptProvider {
  isRead(_message: PteIMIncomingMessage): boolean { return false }
}

/** Explicit colours for one appearance. Light and dark palettes are never auto-inverted. */
export type PteIMUIThemePalette = {
  background: string; surface: string; composer: string; incoming: string; outgoingStart: string; outgoingEnd: string
  text: string; muted: string; incomingText: string; outgoingText: string; icon: string; divider: string; panel: string; panelItem: string; composerInput: string
}

/** Pass a custom instance to PteIMUIChat when the host needs per-component branding. */
export class PteIMUITheme {
  light: PteIMUIThemePalette
  dark: PteIMUIThemePalette
  constructor(light: PteIMUIThemePalette = PteIMUITheme.lightPalette(), dark: PteIMUIThemePalette = PteIMUITheme.darkPalette()) { this.light = light; this.dark = dark }
  static lightPalette(): PteIMUIThemePalette { return { background: '#F7F9FF', surface: '#FFFFFF', composer: '#FFFFFF', incoming: '#EDF1FD', outgoingStart: '#335EF4', outgoingEnd: '#7D40EF', text: '#171C2E', muted: '#666D84', incomingText: '#171C2E', outgoingText: '#FFFFFF', icon: '#373E5A', divider: '#DDE2F2', panel: '#F4F6FF', panelItem: '#FFFFFF', composerInput: '#F3F3FE' } }
  static darkPalette(): PteIMUIThemePalette { return { background: '#0E111C', surface: '#141827', composer: '#181D2F', incoming: '#252B43', outgoingStart: '#4467FF', outgoingEnd: '#8F4CFF', text: '#EFF2FF', muted: '#A4ADCB', incomingText: '#EFF2FF', outgoingText: '#FFFFFF', icon: '#CCD3F2', divider: '#313854', panel: '#191E30', panelItem: '#262D46', composerInput: '#1F1E42' } }
  static resolve(client: PteIMSDKClient, theme: PteIMUITheme = new PteIMUITheme(), systemDark: boolean = false): PteIMUIThemePalette {
    const mode = client.currentAppearance().themeMode
    return mode === 'dark' || (mode === 'system' && systemDark) ? theme.dark : theme.light
  }
  static cssVariables(palette: PteIMUIThemePalette): any {
    return { '--pte-im-ui-background': palette.background, '--pte-im-ui-surface': palette.surface, '--pte-im-ui-composer': palette.composer, '--pte-im-ui-incoming': palette.incoming, '--pte-im-ui-outgoing-start': palette.outgoingStart, '--pte-im-ui-outgoing-end': palette.outgoingEnd, '--pte-im-ui-text': palette.text, '--pte-im-ui-muted': palette.muted, '--pte-im-ui-incoming-text': palette.incomingText, '--pte-im-ui-outgoing-text': palette.outgoingText, '--pte-im-ui-icon': palette.icon, '--pte-im-ui-divider': palette.divider, '--pte-im-ui-panel': palette.panel, '--pte-im-ui-panel-item': palette.panelItem, '--pte-im-ui-composer-input': palette.composerInput }
  }
}

/** Dependency-free controller consumed by the PteIMUI uvue components or a custom UTS view. */
export class PteIMUIChatController {
  messages: PteIMIncomingMessage[] = []
  /** Per-message delivery state including optimistic uploads before the server echo arrives. */
  messageStates: any = {}
  onChanged: (() => void) | null = null
  onActionRequested: ((action: PteIMUIAction) => void) | null = null
  private active: boolean = true
  private listener: PteIMListener
  private optimistic: PteIMIncomingMessage[] = []
  private visibleLimit: number = 20

  constructor(private client: PteIMSDKClient, readonly conversationId: string) {
    this.listener = {
      onMessage: (message: PteIMIncomingMessage): void => { if (this.active && message.conversationId == conversationId) this.refresh() },
      onMessageStateChanged: (event): void => { if (this.active) { this.messageStates[event.clientMsgId] = event.state; this.refresh() } },
      onThemeModeChanged: (_mode): void => { if (this.active) this.changed() },
      onLanguageChanged: (_language): void => { if (this.active) this.changed() }
    }
    this.refresh()
    client.addListener(this.listener)
  }

  refresh(): void {
    const all = this.client.localMessages(this.conversationId, 1000)
    const local = all.slice(Math.max(0, all.length - this.visibleLimit))
    const localIds = local.map((message: PteIMIncomingMessage) => message.clientMsgId)
    this.optimistic = this.optimistic.filter((message: PteIMIncomingMessage) => localIds.indexOf(message.clientMsgId) < 0)
    this.messages = local.concat(this.optimistic).sort((left: PteIMIncomingMessage, right: PteIMIncomingMessage) => left.createdAt - right.createdAt)
    this.changed()
  }
  /** Reveals the next page of durable, server-synchronised history. */
  loadOlder(): void {
    const available = this.client.localMessages(this.conversationId, 1000).length
    this.visibleLimit = Math.min(available, this.visibleLimit + 20)
    this.refresh()
  }
  hasOlder(): boolean { return this.client.localMessages(this.conversationId, 1000).length > this.visibleLimit }
  sendText(text: string): string {
    const value = text.trim()
    if (value.length == 0) return ''
    const clientMsgId = this.client.sendText(this.conversationId, value)
    this.trackOutgoing(clientMsgId, 'text', { text: value })
    return clientMsgId
  }
  sendEmoji(packageId: string = 'default', emojiId: string = 'smile_001'): string {
    const clientMsgId = this.client.sendEmoji(this.conversationId, packageId, emojiId)
    this.trackOutgoing(clientMsgId, 'emoji', { packageId, emojiId })
    return clientMsgId
  }
  trackOutgoing(clientMsgId: string, type: string, content: any): void {
    if (clientMsgId.length == 0) return
    this.messageStates[clientMsgId] = this.messageStates[clientMsgId] ?? 'pending'
    const existing = this.optimistic.findIndex((message: PteIMIncomingMessage) => message.clientMsgId == clientMsgId)
    const message = { clientMsgId, conversationId: this.conversationId, senderId: this.client.currentUserId(), type, createdAt: Date.now(), content } as PteIMIncomingMessage
    if (existing >= 0) this.optimistic[existing] = message
    else this.optimistic.push(message)
    this.refresh()
  }
  stateFor(clientMsgId: string): string { return String(this.messageStates[clientMsgId] ?? 'sent') }
  requestAction(action: PteIMUIAction): void { this.onActionRequested?.(action) }
  dispose(): void { this.active = false; this.client.removeListener(this.listener); this.onChanged = null; this.onActionRequested = null }
  private changed(): void { this.onChanged?.() }
}

/**
 * Conversation rows are driven by the server's conversation summaries.  A
 * message-only cache is not enough: a newly logged-in device can legitimately
 * have no local messages while the account already owns conversations.
 */
export class PteIMUIConversationListController {
  conversations: PteIMConversation[] = []
  onChanged: (() => void) | null = null
  private active: boolean = true
  private listener: PteIMListener
  private loadingRemote: boolean = false
  private loadingFriendNames: boolean = false
  private friendNames: any = {}
  private friendAvatars: any = {}
  private refreshVersion: number = 0
  constructor(private client: PteIMSDKClient) {
    this.listener = {
      onConnectionChanged: (connected: boolean): void => { if (this.active && connected) this.refresh() },
      onMessage: (_message): void => { if (this.active) this.refresh() },
      onMessageStateChanged: (_event): void => { if (this.active) this.refresh() }
    }
    this.refresh()
    client.addListener(this.listener)
  }
  refresh(): void {
    // Render the durable cache immediately, then replace/complete it with the
    // authoritative page. This keeps offline behaviour while fixing a first
    // login after server-side data was prepared.
    this.conversations = this.client.localConversations(100)
    this.onChanged?.()
    this.loadFriendNames()
    this.loadRemotePage()
  }
  private loadFriendNames(): void {
    if (this.loadingFriendNames || Object.keys(this.friendNames).length > 0) return
    this.loadingFriendNames = true
    this.client.fetchFriends('', 100, (page, error): void => {
      this.loadingFriendNames = false
      if (!this.active || page == null || error != null) return
      page.list.forEach((friend: PteIMContact): void => {
        const title = friend.remark.length > 0 ? friend.remark : friend.nickname
        if (title.length > 0) this.friendNames[friend.userId] = title
        if (friend.avatar.length > 0) this.friendAvatars[friend.userId] = friend.avatar
      })
      // A conversation request already in flight will use these names. When
      // it has completed, load the summaries once more to update the labels.
      if (!this.loadingRemote) this.loadRemotePage()
    })
  }
  private loadRemotePage(): void {
    if (this.loadingRemote) return
    this.loadingRemote = true
    const version = ++this.refreshVersion
    this.client.fetchConversationPage(1, 100, (page, error): void => {
      this.loadingRemote = false
      if (!this.active || version != this.refreshVersion || page == null || error != null) return
      this.conversations = this.mergeRemoteConversations(page.items)
      this.onChanged?.()
    })
  }
  private mergeRemoteConversations(remoteValues: PteIMRemoteConversation[]): PteIMConversation[] {
    const localValues = this.client.localConversations(100)
    const localByConversation: any = {}
    localValues.forEach((value: PteIMConversation): void => { localByConversation[value.conversationId] = value })
    const merged: PteIMConversation[] = []
    remoteValues.forEach((remote: PteIMRemoteConversation): void => {
      const conversationId = String(remote.id)
      const local = localByConversation[conversationId] as PteIMConversation | null
      const placeholder: PteIMIncomingMessage = {
        clientMsgId: 'pte-im-summary-' + conversationId,
        conversationId,
        type: 'text',
        createdAt: remote.lastMessageAt * 1000,
        content: { text: remote.lastMessageSnapshot ?? '' }
      }
      merged.push({
        conversationId,
        lastMessage: local?.lastMessage ?? placeholder,
        updatedAt: local?.updatedAt ?? placeholder.createdAt,
        title: this.titleForRemote(remote, conversationId),
        avatar: this.avatarForRemote(remote),
        unreadCount: remote.unreadCount
      })
      delete localByConversation[conversationId]
    })
    Object.keys(localByConversation).forEach((conversationId: string): void => {
      merged.push(localByConversation[conversationId] as PteIMConversation)
    })
    return merged.sort((left: PteIMConversation, right: PteIMConversation): number => right.updatedAt - left.updatedAt)
  }
  private titleForRemote(remote: PteIMRemoteConversation, conversationId: string): string {
    if (remote.title.length > 0) return remote.title
    if (remote.type != 'single') return conversationId
    const currentUserId = this.client.currentUserId()
    const peerId = (remote.singleKey ?? '').split(':').find((value: string): boolean => value != currentUserId)
    if (peerId != null && this.friendNames[peerId] != null) return String(this.friendNames[peerId])
    return '私聊'
  }
  private avatarForRemote(remote: PteIMRemoteConversation): string {
    if (String(remote.avatar ?? '').length > 0) return String(remote.avatar)
    if (remote.type != 'single') return ''
    const currentUserId = this.client.currentUserId()
    const peerId = (remote.singleKey ?? '').split(':').find((value: string): boolean => value != currentUserId)
    return peerId != null && this.friendAvatars[peerId] != null ? String(this.friendAvatars[peerId]) : ''
  }
  dispose(): void { this.active = false; this.client.removeListener(this.listener); this.onChanged = null }
}

/**
 Cursor-paginated friend/follow/group directory for UTS targets. It exposes
 data and callbacks rather than owning navigation, so H5, WeChat and native
 hosts can reuse their own router and visual row component.
 */
export class PteIMUIContactListController {
  contacts: PteIMUIContactPresentation[] = []
  hasMore: boolean = false
  loading: boolean = false
  onChanged: (() => void) | null = null
  onError: ((message: string) => void) | null = null
  onConversationSelected: ((conversationId: string, title: string, avatar: string) => void) | null = null
  private cursor: string = ''
  private active: boolean = true
  private listener: PteIMListener

  constructor(private client: PteIMSDKClient, readonly mode: PteIMUIContactListMode = 'friends') {
    this.listener = { onThemeModeChanged: (_mode): void => { if (this.active) this.changed() }, onLanguageChanged: (_language): void => { if (this.active) this.changed() } }
    client.addListener(this.listener)
  }

  refresh(): void { this.cursor = ''; this.hasMore = false; if (this.mode === 'custom') { this.changed(); return }; this.loadNextPage(true) }
  loadNextPage(replacing: boolean = false): void {
    if (this.mode === 'custom' || this.loading || (!replacing && !this.hasMore && this.contacts.length > 0)) return
    this.loading = true
    const cursor = replacing ? '' : this.cursor
    if (this.mode === 'groups') this.client.fetchGroups(cursor, 50, (page, error) => this.receiveGroups(page, error, replacing))
    else if (this.mode === 'follows') this.client.fetchFollows(cursor, 50, (page, error) => this.receiveContacts(page, error, replacing))
    else this.client.fetchFriends(cursor, 50, (page, error) => this.receiveContacts(page, error, replacing))
  }
  /** CUSTOM mode accepts host-owned rows and makes no SDK request. */
  setCustomContacts(values: PteIMUIContactPresentation[]): void {
    if (this.mode !== 'custom') { this.failed('setCustomContacts requires custom mode'); return }
    this.contacts = values; this.cursor = ''; this.hasMore = false; this.changed()
  }
  dispose(): void { this.active = false; this.client.removeListener(this.listener); this.onChanged = null; this.onError = null; this.onConversationSelected = null }
  select(item: PteIMUIContactPresentation): void {
    if (item.isGroup) { this.onConversationSelected?.(item.identifier, item.title, String(item.avatar ?? '')); return }
    if (!/^[1-9][0-9]*$/.test(item.identifier)) { this.failed('invalid contact userId'); return }
    const userId = Number(item.identifier)
    this.client.openSingleConversation(userId, (conversation, error) => {
      if (conversation == null || error != null) { this.failed(error ?? 'could not open conversation'); return }
      this.onConversationSelected?.(String(conversation.id), item.title, String(item.avatar ?? ''))
    })
  }
  private receiveContacts(page: PteIMContactPage | null, error: string | null, replacing: boolean): void {
    if (page == null || error != null) { this.failed(error ?? 'could not load contacts'); return }
    const values = page.list.map((contact: PteIMContact): PteIMUIContactPresentation => {
      const title = contact.remark.length > 0 ? contact.remark : (contact.nickname.length > 0 ? contact.nickname : contact.userId)
      return { identifier: contact.userId, title, subtitle: contact.remark.length > 0 ? contact.nickname : '', avatarText: title.substring(0, 1), avatar: contact.avatar, isGroup: false, online: Boolean((contact as any).online) }
    })
    this.apply(values, page.nextCursor, page.hasMore, replacing)
  }
  private receiveGroups(page: PteIMGroupPage | null, error: string | null, replacing: boolean): void {
    if (page == null || error != null) { this.failed(error ?? 'could not load groups'); return }
    const values = page.list.map((group): PteIMUIContactPresentation => {
      const identifier = String(group.id); const title = group.title.length > 0 ? group.title : identifier
      return { identifier, title, subtitle: String((group as any).subtitle ?? group.lastMessageSnapshot ?? ''), avatarText: title.substring(0, 1), avatar: String(group.avatar ?? ''), isGroup: true }
    })
    this.apply(values, page.nextCursor, page.hasMore, replacing)
  }
  private apply(values: PteIMUIContactPresentation[], nextCursor: string, hasMore: boolean, replacing: boolean): void {
    const source = replacing ? values : this.contacts.concat(values)
    const unique: PteIMUIContactPresentation[] = []
    source.forEach((item: PteIMUIContactPresentation) => { if (!unique.some((value: PteIMUIContactPresentation) => value.identifier === item.identifier && value.isGroup === item.isGroup)) unique.push(item) })
    this.contacts = unique; this.cursor = nextCursor; this.hasMore = hasMore; this.loading = false; this.changed()
  }
  private failed(message: string): void { this.loading = false; this.onError?.(message); this.changed() }
  private changed(): void { this.onChanged?.() }
}

/** Public UTS UI Kit entry point, independent from configuration and login. */
export class PteIMUIKit {
  static createChatController(client: PteIMSDKClient, conversationId: string): PteIMUIChatController { return new PteIMUIChatController(client, conversationId) }
  static createConversationListController(client: PteIMSDKClient): PteIMUIConversationListController { return new PteIMUIConversationListController(client) }
  static createContactListController(client: PteIMSDKClient, mode: PteIMUIContactListMode = 'friends'): PteIMUIContactListController { return new PteIMUIContactListController(client, mode) }
}
