import { PteIMConversation, PteIMIncomingMessage, PteLiveIMClient } from './interface.uts'

/** Actions that require host application permissions, pickers, or business data. */
export type PteIMUIAction = 'image' | 'video' | 'voice' | 'location' | 'gift' | 'red_packet' | 'order'

/** Dependency-free controller consumed by the PteIMUI uvue components or a custom UTS view. */
export class PteIMUIChatController {
  messages: PteIMIncomingMessage[] = []
  onChanged: (() => void) | null = null
  onActionRequested: ((action: PteIMUIAction) => void) | null = null
  private active: boolean = true

  constructor(private client: PteLiveIMClient, readonly conversationId: string) {
    this.refresh()
    client.onMessage((message: PteIMIncomingMessage) => { if (this.active && message.conversationId == conversationId) this.refresh() })
    client.onMessageStateChanged((_event) => { if (this.active) this.refresh() })
    client.onThemeModeChanged((_mode) => { if (this.active) this.changed() })
    client.onLanguageChanged((_language) => { if (this.active) this.changed() })
  }

  refresh(): void { this.messages = this.client.localMessages(this.conversationId, 100); this.changed() }
  sendText(text: string): void { if (text.trim().length > 0) { this.client.sendText(this.conversationId, text.trim()); this.refresh() } }
  sendEmoji(packageId: string = 'default', emojiId: string = 'smile_001'): void { this.client.sendEmoji(this.conversationId, packageId, emojiId); this.refresh() }
  requestAction(action: PteIMUIAction): void { this.onActionRequested?.(action) }
  dispose(): void { this.active = false; this.onChanged = null; this.onActionRequested = null }
  private changed(): void { this.onChanged?.() }
}

/** Cache-first conversation controller. Call refresh after an explicit sync when necessary. */
export class PteIMUIConversationListController {
  conversations: PteIMConversation[] = []
  onChanged: (() => void) | null = null
  private active: boolean = true
  constructor(private client: PteLiveIMClient) {
    this.refresh()
    client.onMessage((_message) => { if (this.active) this.refresh() })
    client.onMessageStateChanged((_event) => { if (this.active) this.refresh() })
  }
  refresh(): void { this.conversations = this.client.localConversations(100); this.onChanged?.() }
  dispose(): void { this.active = false; this.onChanged = null }
}

/** Public UTS UI Kit entry point, independent from configuration and login. */
export class PteIMUIKit {
  static createChatController(client: PteLiveIMClient, conversationId: string): PteIMUIChatController { return new PteIMUIChatController(client, conversationId) }
  static createConversationListController(client: PteLiveIMClient): PteIMUIConversationListController { return new PteIMUIConversationListController(client) }
}
