import { UTSAndroid } from 'io.dcloud.uts'
import { PteIMAppearance, PteIMBaseConfig, PteIMLoginConfig, PteIMMedia, PteIMVoice, PteIMLocation, PteIMBusinessContent, PteIMIncomingMessage, PteIMMessageStateChange, PteIMConversation, PteIMRemoteConversation, PteIMConversationPage, PteIMMessagePage, PteLiveIMBootstrap, PteLiveIMClient } from '../interface.uts'
import { PteIMBaseConfig as NativeBaseConfig, PteIMLoginConfig as NativeLoginConfig, PteIMMedia as NativeMedia, PteIMVoice as NativeVoice, PteIMLocation as NativeLocation, PteIMBusinessContent as NativeBusinessContent, PteIMMessage as NativeMessage, PteIMConversation as NativeConversation, PteLiveIM } from 'com.ptelive.im'

class AndroidPteLiveIMClient implements PteLiveIMClient {
  private nativeClient: PteLiveIM
  private connectionCallback: ((connected: boolean) => void) | null = null
  private messageCallback: ((message: PteIMIncomingMessage) => void) | null = null
  private messageStateCallback: ((event: PteIMMessageStateChange) => void) | null = null
  private userSigWillExpireCallback: (() => void) | null = null
  private userSigExpiredCallback: (() => void) | null = null
  private themeModeCallback: ((themeMode: 'system' | 'light' | 'dark') => void) | null = null
  private languageCallback: ((language: 'system' | 'zh-CN' | 'en-US') => void) | null = null
  private errorCallback: ((message: string) => void) | null = null
  private appearance: PteIMAppearance

  constructor(nativeClient: PteLiveIM, base: PteIMBaseConfig) { this.nativeClient = nativeClient; this.appearance = { themeMode: base.themeMode ?? 'system', language: base.language ?? 'system' } }

  start(): void { this.nativeClient.start() }
  stop(): void { this.nativeClient.stop() }
  renewUserSig(userSig: string): void { this.nativeClient.renewUserSig(userSig) }
  updateAppearance(themeMode?: 'system' | 'light' | 'dark', language?: 'system' | 'zh-CN' | 'en-US'): PteIMAppearance {
    const previous = this.appearance
    this.appearance = { themeMode: themeMode ?? previous.themeMode, language: language ?? previous.language }
    if (previous.themeMode != this.appearance.themeMode) this.themeModeCallback?.(this.appearance.themeMode)
    if (previous.language != this.appearance.language) this.languageCallback?.(this.appearance.language)
    return this.appearance
  }
  currentAppearance(): PteIMAppearance { return this.appearance }
  syncNow(): void { this.nativeClient.syncNow() }
  localMessages(conversationId: string, limit: number = 50): PteIMIncomingMessage[] {
    const values: PteIMIncomingMessage[] = []
    this.nativeClient.localMessages(conversationId, null, limit).forEach((message: NativeMessage) => values.push(nativeMessage(message)))
    return values
  }
  localConversations(limit: number = 100): PteIMConversation[] {
    const values: PteIMConversation[] = []
    this.nativeClient.localConversations(limit).forEach((conversation: NativeConversation) => values.push({ conversationId: conversation.conversationId, lastMessage: nativeMessage(conversation.lastMessage), updatedAt: conversation.updatedAt }))
    return values
  }
  fetchConversationPage(_page: number, _pageSize: number, callback: (result: PteIMConversationPage | null, error: string | null) => void): void { callback(null, 'Use the independent Android SDK pagination API') }
  openSingleConversation(_peerUserId: number, callback: (result: PteIMRemoteConversation | null, error: string | null) => void): void { callback(null, 'Use the independent Android SDK openSingleConversation API') }
  createGroupConversation(_title: string, _memberIds: number[], _avatar: string | null, callback: (result: PteIMRemoteConversation | null, error: string | null) => void): void { callback(null, 'Use the independent Android SDK createGroupConversation API') }
  markConversationRead(_conversationId: number, _seq: number, callback: (error: string | null) => void): void { callback('Use the independent Android SDK markConversationRead API') }
  fetchMessageHistory(_conversationId: number, _beforeSeq: number, _limit: number, callback: (result: PteIMMessagePage | null, error: string | null) => void): void { callback(null, 'Use the independent Android SDK pagination API') }
  sendText(conversationId: string, text: string): string { return this.nativeClient.sendText(conversationId, text).clientMsgId }
  sendEmoji(conversationId: string, packageId: string, emojiId: string): string { return this.nativeClient.sendEmoji(conversationId, packageId, emojiId).clientMsgId }
  sendImage(conversationId: string, media: PteIMMedia): string { return this.nativeClient.sendImage(conversationId, nativeMedia(media)).clientMsgId }
  sendVideo(conversationId: string, media: PteIMMedia): string { return this.nativeClient.sendVideo(conversationId, nativeMedia(media)).clientMsgId }
  uploadAndSendImage(_conversationId: string, _filePath: string): string { throw new Error('Use the independent Android PteLiveIM SDK uploadAndSendImage with a content URI') }
  uploadAndSendVideo(_conversationId: string, _filePath: string): string { throw new Error('Use the independent Android PteLiveIM SDK uploadAndSendVideo with a content URI') }
  uploadAndSendVoice(_conversationId: string, _filePath: string, _durationMs: number, _waveform: string = ''): string { throw new Error('Use the independent Android PteLiveIM SDK uploadAndSendVoice with a content URI') }
  sendVoice(conversationId: string, voice: PteIMVoice): string { return this.nativeClient.sendVoice(conversationId, new NativeVoice(voice.url, voice.durationMs, voice.waveform, voice.sizeBytes)).clientMsgId }
  sendLocation(conversationId: string, location: PteIMLocation): string { return this.nativeClient.sendLocation(conversationId, new NativeLocation(location.latitude, location.longitude, location.name, location.address)).clientMsgId }
  sendGift(conversationId: string, content: PteIMBusinessContent): string { return this.nativeClient.sendGift(conversationId, nativeBusinessContent(content)).clientMsgId }
  sendRedPacket(conversationId: string, content: PteIMBusinessContent): string { return this.nativeClient.sendRedPacket(conversationId, nativeBusinessContent(content)).clientMsgId }
  sendOrder(conversationId: string, content: PteIMBusinessContent): string { return this.nativeClient.sendOrder(conversationId, nativeBusinessContent(content)).clientMsgId }
  onConnectionChanged(callback: (connected: boolean) => void): void { this.connectionCallback = callback }
  onMessage(callback: (message: PteIMIncomingMessage) => void): void { this.messageCallback = callback }
  onMessageStateChanged(callback: (event: PteIMMessageStateChange) => void): void { this.messageStateCallback = callback }
  onUserSigWillExpire(callback: () => void): void { this.userSigWillExpireCallback = callback }
  onUserSigExpired(callback: () => void): void { this.userSigExpiredCallback = callback }
  onThemeModeChanged(callback: (themeMode: 'system' | 'light' | 'dark') => void): void { this.themeModeCallback = callback }
  onLanguageChanged(callback: (language: 'system' | 'zh-CN' | 'en-US') => void): void { this.languageCallback = callback }
  onError(callback: (message: string) => void): void { this.errorCallback = callback }
}

class AndroidPteLiveIMBootstrap implements PteLiveIMBootstrap {
  private base: PteIMBaseConfig
  constructor(base: PteIMBaseConfig) { this.base = base }
  login(config: PteIMLoginConfig): PteLiveIMClient {
    const nativeBase = new NativeBaseConfig(this.base.apiDomain, this.base.imDomain, this.base.cosDomain)
    const nativeLogin = new NativeLoginConfig(config.sdkAppId.toLong(), config.userId, config.userSig)
    return new AndroidPteLiveIMClient(PteLiveIM.configure(UTSAndroid.getAppContext(), nativeBase).login(nativeLogin), this.base)
  }
}

export function createPteLiveIM(config: PteIMBaseConfig): PteLiveIMBootstrap {
  return new AndroidPteLiveIMBootstrap(config)
}

function nativeMedia(media: PteIMMedia): NativeMedia {
  return new NativeMedia(media.url, media.thumbnailUrl, media.coverUrl, media.width, media.height, media.durationMs, media.sizeBytes)
}

function nativeBusinessContent(content: PteIMBusinessContent): NativeBusinessContent {
  return new NativeBusinessContent(content.businessId, content.title, content.subtitle, content.actionUrl)
}

function nativeMessage(message: NativeMessage): PteIMIncomingMessage {
  return {
    clientMsgId: message.clientMsgId,
    serverMsgId: message.serverMsgId,
    conversationId: message.conversationId,
    type: message.type.name.lowercase(),
    createdAt: message.createdAt,
    serverSeq: message.serverSeq,
    content: JSON.parse(message.contentJson().toString()),
  }
}
